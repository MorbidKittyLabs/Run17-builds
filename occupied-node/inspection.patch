diff --git a/mods/src/prime/navigation_binding.h b/mods/src/prime/navigation_binding.h
new file mode 100644
index 0000000..536145c
--- /dev/null
+++ b/mods/src/prime/navigation_binding.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <il2cpp/il2cpp_helper.h>
+#include <il2cpp/method_contract.h>
+#include <cstdint>
+#include <cstring>
+
+// Checked, exception-aware bindings for the optional occupied-node viewer.
+// No client offsets or managed object references are cached.
+namespace navigation_binding
+{
+inline const MethodInfo* Method(Il2CppObject* object, const char* name, const char* result,
+                                std::initializer_list<const char*> parameters = {})
+{
+  for (auto* cls = object ? object->klass : nullptr; cls; cls = il2cpp_class_get_parent(cls)) {
+    if (auto* method = method_contract::Resolve(cls, name, false, result, parameters))
+      return method;
+  }
+  return nullptr;
+}
+
+inline bool Invoke(const MethodInfo* method, Il2CppObject* object, void** args, Il2CppObject*& result)
+{
+  result = nullptr;
+  if (!method || !method->invoker_method) return false;
+  Il2CppException* exception = nullptr;
+  result = il2cpp_runtime_invoke(method, object, args, &exception);
+  return !exception;
+}
+
+inline Il2CppObject* Reference(Il2CppObject* object, const char* getter, const char* type)
+{
+  Il2CppObject* result = nullptr;
+  auto* method = Method(object, getter, type);
+  return Invoke(method, object, nullptr, result) ? result : nullptr;
+}
+
+inline Il2CppObject* ReferenceField(Il2CppObject* object, const char* name, const char* type)
+{
+  auto* field = object ? il2cpp_class_get_field_from_name(object->klass, name) : nullptr;
+  if (!field || (field->type->attrs & FIELD_ATTRIBUTE_STATIC) || !method_contract::Type(field->type, type))
+    return nullptr;
+  return il2cpp_field_get_value_object(field, object);
+}
+
+template <typename T>
+bool Value(Il2CppObject* object, const char* getter, const char* type, T& value)
+{
+  Il2CppObject* boxed = nullptr;
+  if (!Invoke(Method(object, getter, type), object, nullptr, boxed) || !boxed
+      || !method_contract::Type(il2cpp_class_get_type(boxed->klass), type)) return false;
+  auto* data = il2cpp_object_unbox(boxed);
+  if (!data) return false;
+  std::memcpy(&value, data, sizeof(value));
+  return true;
+}
+
+inline bool Select(Il2CppObject* object, const char* name, int64_t id)
+{
+  auto* method = Method(object, name, "System.Boolean", {"System.Int64"});
+  Il2CppObject* boxed = nullptr;
+  void* args[] = {&id};
+  return Invoke(method, object, args, boxed) && boxed
+         && method_contract::Type(il2cpp_class_get_type(boxed->klass), "System.Boolean")
+         && *static_cast<bool*>(il2cpp_object_unbox(boxed));
+}
+} // namespace navigation_binding
diff --git a/tests/occupied_node_cycle.cc b/tests/occupied_node_cycle.cc
new file mode 100644
index 0000000..d9ca6fb
--- /dev/null
+++ b/tests/occupied_node_cycle.cc
@@ -0,0 +1,40 @@
+#include "patches/parts/occupied_node_cycle.h"
+#include <iostream>
+#include <stdexcept>
+
+using namespace occupied_node_inspection;
+void Require(bool condition) { if (!condition) throw std::runtime_error("occupied node regression"); }
+
+int main()
+{
+  Cycle cycle;
+  const Address origin{4, 5000000011LL, 1};
+  const int64_t node = 9000000011LL, fleet = 8000000022LL;
+  Require(!cycle.Begin(origin, node, node, 0));
+  Require(!cycle.Active());
+  Require(cycle.Begin(origin, node, fleet, 10));
+  Require(cycle.Matches(origin, node, 10.1));
+  Require(cycle.Matches(origin, 0, 10.2)); // native binding gap
+  Require(cycle.Matches(origin, fleet, 10.3));
+  Require(!cycle.Matches(origin, fleet + 1, 10.3)); // unrelated/replacement fleet
+  Require(!cycle.Matches({4, origin.system + 1, 1}, fleet, 10.3));
+  Require(!cycle.Matches({4, origin.system, 2}, fleet, 10.3)); // same system, other instance
+  Require(!cycle.Matches({5, origin.system, 1}, fleet, 10.3));
+  Require(!cycle.Matches(origin, fleet, 12)); // exact deadline
+  cycle.phase = Cycle::Phase::Loot;
+  Require(cycle.Matches(origin, fleet, 100)); // no inspection duration limit
+  Require(!cycle.Matches(origin, node, 100));
+  Require(!cycle.Matches(origin, 0, 100)); // dismissed selection
+  cycle.phase = Cycle::Phase::Strength;
+  Require(cycle.Matches(origin, fleet, 100));
+  cycle.Restoring(100);
+  Require(cycle.Active() && cycle.Pending()); // true SelectPoi is not binding success
+  Require(cycle.node == node && cycle.occupant == fleet);
+  Require(cycle.Matches(origin, node, 101));
+  Require(!cycle.Matches(origin, node, 102)); // restoration timeout
+  cycle.Clear();
+  Require(!cycle.Active() && cycle.node == 0 && cycle.occupant == 0);
+  Require(cycle.Begin(origin, node, fleet + 1, 105)); // fresh occupant on next cycle
+  Require(cycle.occupant == fleet + 1);
+  std::cout << "Occupied node identity, selection, instance and timeout regressions passed\n";
+}
