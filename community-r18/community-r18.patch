diff --git a/mods/src/diagnostic_monitor_policy.h b/mods/src/diagnostic_monitor_policy.h
new file mode 100644
index 0000000..b516c9b
--- /dev/null
+++ b/mods/src/diagnostic_monitor_policy.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+namespace fleet_diagnostics::diagnostics {
+inline constexpr std::size_t MaxDockSlots=16;
+struct MonitorSchedule {
+  uint64_t next_ui=0,next_roster=0,next_detail=0,next_log=0,deferred_until=0;
+  std::size_t cursor=0;
+  bool Ready(uint64_t now,uint64_t& next,uint64_t cadence) {
+    if(now<deferred_until || now<next)return false;
+    next=now+cadence;return true;
+  }
+  bool UI(uint64_t now){return Ready(now,next_ui,200);}
+  bool Roster(uint64_t now){return Ready(now,next_roster,1000);}
+  bool Log(uint64_t now){return Ready(now,next_log,2000);}
+  std::optional<std::size_t> Detail(uint64_t now,std::size_t count,bool owner) {
+    if(!owner || !count || count>MaxDockSlots || !Ready(now,next_detail,250))return std::nullopt;
+    const auto index=cursor%count;cursor=(index+1)%count;return index;
+  }
+  void Failure(uint64_t now){deferred_until=now+2000;}
+};
+}
