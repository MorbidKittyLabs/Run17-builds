+  const auto began=Now();size_t read=0;Json probes=Json::array();const bool probing=now-probe_logged>=2000;
+  for(const auto id:work){
+   // Always service previously linked pairs first; bound discovery work on busy screens.
+   if(read>=active && Now()-began>6)break;
+   if(read>=active)pursuit_cursor=next_cursor[read-active];++read;
+   auto* model=VisibleHostileModel(id);if(!model)continue;
+   const auto data=PursuitNative(model);const auto target=PursuitId(data.target);
+   const bool linked=target && *target==own_id;
+   if(probing && probes.size()<8)probes.push_back({{"fleet_id",std::to_string(id)},
+    {"ref_id",Scalar(Object(model),"RefId")},{"fleet_type",Scalar(Object(model),"FleetType")},
+    {"pursuit_target_id",data.target},{"pursued_by_num",data.count},{"course_x",data.x},{"course_y",data.y}});
+   auto it=pursuit_tracks.find(id);
+   if(it==pursuit_tracks.end()){
+    if(!linked)continue;
+    if(pursuit_tracks.size()>=32)continue;
+    it=pursuit_tracks.emplace(id,PursuitTrack{}).first;
+   }
+   auto& t=it->second;t.seen=now;t.ever|=linked;t.linked=linked;
+   const auto x=PursuitNumber(data.x),y=PursuitNumber(data.y);
+   std::optional<po::Point> direction;if(x&&y)direction=po::Point{*x,*y,0};
+   const auto position=PursuitPosition(id);const auto battling=Scalar(Object(model),"CurrentlyBattling");
+   const auto flags=t.observer.Update({now,own_id,target,own_count,position,direction,
+     own->CurrentState==FleetState::IdleInSpace,battling.is_boolean()?std::optional<bool>(battling.get<bool>()):std::nullopt});
+   if(flags.acquired || flags.link_cleared || flags.course_changed || flags.dormant_candidate || now-t.logged>=250){
+    t.logged=now;auto record=own_data;
+    record["event"]="pursuit_pair_sample";record["target_id"]=std::to_string(id);
+    record["hostile"]=Json{{"pursuit_target_id",data.target},{"pursued_by_num",data.count},
+      {"course_vector",PursuitPoint(direction)},{"position",PursuitPoint(position)},
+      {"currently_battling",battling},{"current_state",Scalar(Object(model),"CurrentState")},
+      {"current_state_label",EnumLabel(Object(model),"CurrentState")},{"fleet_type",Scalar(Object(model),"FleetType")},
+      {"ref_id",Scalar(Object(model),"RefId")}};
+    record["signals"]=Json{{"target_id_matches_own",flags.linked},{"link_acquired",flags.acquired},
+      {"link_cleared",flags.link_cleared},{"course_turn_at_least_15_degrees",flags.course_changed},
+      {"stopped_and_clear_candidate",flags.dormant_candidate}};
+    record["candidate_rule"]="previously linked; explicit nonmatching target ID; own pursued count zero; own idle; hostile not battling; position within 0.25 model units for 1s; no observation gaps over 500ms";
+    Write(std::move(record));
+   }
+  }
+  if(probing){probe_logged=now;auto record=own_data;record["event"]="pursuit_visible_probe";
+   record["visible_ids"]=ids.size();record["models_read"]=read;record["discovery_cursor"]=pursuit_cursor;
+   record["examples"]=probes;record["tracked_pairs"]=pursuit_tracks.size();Write(std::move(record));}
+ }catch(const std::exception& e){
+  pursuit_tracks.clear();pursuit_own_key.clear();
+  static int64_t error_logged=-1000;if(now-error_logged>=1000){error_logged=now;Write({{"event","pursuit_reader_error"},{"error",e.what()},{"outcome","unknown"}});}
+ }
+}
diff --git a/mods/src/pursuit_observer_policy.h b/mods/src/pursuit_observer_policy.h
new file mode 100644
index 0000000..c364f75
--- /dev/null
+++ b/mods/src/pursuit_observer_policy.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <optional>
+namespace hostile_audit::pursuit_observer {
+struct Point { double x=0,y=0,z=0; };
+inline bool Finite(Point p){return std::isfinite(p.x)&&std::isfinite(p.y)&&std::isfinite(p.z);}
+inline double Distance2(Point a,Point b){const auto x=a.x-b.x,y=a.y-b.y,z=a.z-b.z;return x*x+y*y+z*z;}
+inline bool Turned(Point a,Point b){
+ const auto aa=Distance2(a,{}),bb=Distance2(b,{});
+ if(!Finite(a)||!Finite(b)||aa<.0001||bb<.0001)return false;
+ return (a.x*b.x+a.y*b.y+a.z*b.z)/std::sqrt(aa*bb)<.9659258262890683; // 15 degrees
+}
+struct Observation {
+ int64_t now=0;uint64_t own=0;std::optional<uint64_t> target;
+ std::optional<int> pursued_count;
+ std::optional<Point> position,course;
+ bool own_idle=false;std::optional<bool> battling;
+};
+struct Result {bool linked=false,acquired=false,link_cleared=false,course_changed=false,dormant_candidate=false;};
+class Observer {
+ uint64_t own=0;int64_t last=-1,clear_since=-1;
+ bool ever_linked=false,was_linked=false,reported=false;
+ std::optional<Point> course,anchor;
+public:
+ void Reset(){*this=Observer{};}
+ Result Update(const Observation& o){
+  if(!o.own || (last>=0 && (o.now<=last || o.now-last>500)) || (own && own!=o.own))Reset();
+  own=o.own;last=o.now;
+  Result r;r.linked=o.target && *o.target==o.own;
+  r.acquired=r.linked&&!was_linked;
+  r.link_cleared=was_linked && o.target && *o.target!=o.own;
+  if(o.course && Finite(*o.course)){
+   r.course_changed=ever_linked && course && Turned(*course,*o.course);
+   // Update reference only for significant turns, avoiding incremental drift hiding a turn.
+   if(!course || r.course_changed)course=o.course;
+  }else course.reset();
+  if(r.linked){ever_linked=true;was_linked=true;reported=false;}
+  else if(o.target)was_linked=false;
+  // Missing values are unknown, not evidence that pursuit has ended.
+  const bool clear=ever_linked && o.target && *o.target!=o.own && o.pursued_count && *o.pursued_count==0
+      && o.own_idle && o.battling && !*o.battling && o.position && Finite(*o.position);
+  if(!clear){clear_since=-1;anchor.reset();reported=false;return r;}
+  if(!anchor || Distance2(*anchor,*o.position)>.0625){anchor=o.position;clear_since=o.now;reported=false;}
+  if(clear_since>=0 && o.now-clear_since>=1000 && !reported){r.dormant_candidate=true;reported=true;}
+  return r;
+ }
+};
+}
