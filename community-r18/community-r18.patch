+template<class Bar,class Manager> bool SelectAndLocate(int index,Bar* bar,Manager* manager,int display_index=-1) {
+ if(index<0 || index>=8 || !bar || !manager)return false;
+ auto* fleet=manager->GetFleetPlayerData(index);
+ if(!fleet || !fleet->Hull)return false;
+ bar->RequestSelect(display_index<0?index:display_index);
+ manager->RequestViewFleet(fleet,true);
+ return true;
+}
+
+inline bool Visible(bool map_or_base,bool observed,bool active,bool blocked) {
+ return map_or_base && observed && active && !blocked;
+}
+inline bool BlockingCanvas(std::string_view name) {
+ for(auto word:{"claim","gift","event"})
+  if(name.find(word)!=std::string_view::npos)return true;
+ return false;
+}
