+void Save(std::vector<Setting> values,std::filesystem::path path) noexcept {
+  bool ok=false;
+  try {
+    const auto original=ReadConfigText(path);
+    auto current=original;
+    config_edit::TomlEditor editor;
+    for(const auto& s:values) {
+      const auto parsed=toml::parse(current);
+      const auto* section=parsed.get_as<toml::table>(s.section);
+      const auto* node=section?section->get(s.key):nullptr;
+      const std::optional<Value> expected=node?std::optional<Value>{Existing(node)}:std::nullopt;
+      const auto edit=editor.Prepare(current,{s.section,s.key,expected,s.value});
+      if(edit.outcome==config_edit::Outcome::Prepared) current=edit.text;
+      else if(edit.outcome!=config_edit::Outcome::AlreadySaved) throw std::runtime_error("Setting edit rejected");
+    }
+    // Reparse the complete candidate, preserve a rolling backup, then commit once.
+    (void)toml::parse(current);
+    if(current!=original) {
+      auto backup=path;backup+=".before-save.bak";
+      ReplaceConfigText(backup,original);
+      if(!ReplaceConfigText(path,current,original)) throw std::runtime_error("Settings changed externally during save");
+    }
+    const auto readback=ReadConfigText(path);
+    if(readback!=current)throw std::runtime_error("TOML read-back did not match the saved snapshot");
+    const auto verified=toml::parse(readback);
+    const auto raw=verified["community_saved"]["system_zoom_distance"].value<double>();
+    const auto zoom=verified["graphics"]["default_system_zoom"].value<double>();
+    if(raw&&zoom&&verified["community_saved"]["system_zoom_distance_enabled"].value_or(true)) {committed_system_default=static_cast<float>(*zoom);committed_system_distance.store(static_cast<float>(*raw),std::memory_order_release);}
+    ok=true;
+    spdlog::info("[SettingsSave] VERIFIED {} settings on disk path={} system_zoom_distance={} default_system_zoom={}",values.size(),path.string(),raw.value_or(-1),zoom.value_or(-1));
+  } catch(const std::exception& e) {spdlog::error("[SettingsSave] Save failed: {}",e.what());}
+  SetEvent(ok?success:failure);
+  busy=false;
+}
+}
+bool NativeStart() {
+  static const bool loaded=[] {
+    try {
+      const auto document=toml::parse_file(std::string(File::MakePath(File::Config())));
+      native_start=document["community_saved"]["factory_start"].value_or(true);
+      native_pan=document["community_saved"]["native_pan"].value_or(true);
+      saved_system_distance=(native_start||!document["community_saved"]["system_zoom_distance_enabled"].value_or(true))?std::numeric_limits<float>::quiet_NaN():document["community_saved"]["system_zoom_distance"].value_or(std::numeric_limits<float>::quiet_NaN());
+      spdlog::info("[SettingsZoom] Loaded config_path={} factory_start={} system_zoom_distance={} default_system_zoom={}",std::string(File::MakePath(File::Config())),native_start,saved_system_distance,Config::Get().default_system_zoom);
+      for(int depth:{1,2,4,8}) {
+        const auto distance=document["community_saved"][NavigationKey(depth)].value<float>();
+        if(!native_start&&distance&&std::isfinite(*distance)&&*distance>=0)saved_navigation_distances[depth]=*distance;
+      }
+      if(auto* saved=document.get_as<toml::table>("community_saved");saved&&!native_start) {
+        for(const auto& [key,node]:*saved) {
+          const auto text=std::string(key.str());
+          if(text.starts_with("blend_zoom_")) {
+            try {const auto ratio=node.value<float>();if(ratio&&std::isfinite(*ratio))saved_blend_ratios.emplace(std::stoi(text.substr(11)),*ratio);}catch(...){}
+          }
+        }
+      }
+      saved_interior_ratio=document["community_saved"]["interior_zoom_ratio"].value_or(std::numeric_limits<float>::quiet_NaN());
+      const auto log=document["community_saved"]["log_level"].value<std::string>();
+      if(log) spdlog::set_level(spdlog::level::from_str(*log));
+    } catch(...) {native_start=true;}
+    return true;
+  }();
+  (void)loaded;return native_start;
+}
+bool NativePan(){(void)NativeStart();return native_pan;}
+void ObserveNavigationZoom(int depth,float distance,float minimum,float maximum,float scale) {
+  if(!NavigationKey(depth))return;
+  const system_zoom_save::Sample sample{distance,minimum,maximum,scale,GetTickCount64()};
+  if(sample.Valid()){navigation_samples[depth]=sample;if(depth==2)system_zoom_sample=sample;}
+}
+float SavedNavigationZoomDistance(int depth){(void)NativeStart();if(depth==2)return saved_system_distance;const auto live=navigation_samples.find(depth);if(live!=navigation_samples.end()&&live->second.Valid())return live->second.distance;const auto found=saved_navigation_distances.find(depth);return found==saved_navigation_distances.end()?std::numeric_limits<float>::quiet_NaN():found->second;}
+void ObserveBlendZoom(int section,float ratio){if(std::isfinite(ratio))blend_samples[section]=ratio;}
+float SavedBlendZoom(int section){(void)NativeStart();const auto live=blend_samples.find(section);if(live!=blend_samples.end())return live->second;const auto found=saved_blend_ratios.find(section);return found==saved_blend_ratios.end()?std::numeric_limits<float>::quiet_NaN():found->second;}
+void ObserveSystemZoom(float distance,float minimum,float maximum,float scale){
+  const system_zoom_save::Sample sample{distance,minimum,maximum,scale,GetTickCount64()};
+  if(sample.Valid())system_zoom_sample=sample;
+}
+float SavedSystemZoomDistance(){(void)NativeStart();return saved_system_distance;}
+void ClearSystemZoomOverride(){saved_system_distance=std::numeric_limits<float>::quiet_NaN();}
+void ObserveNativeUiScale(float v){if(std::isfinite(v)&&v>0)native_ui_scale=v;}
+float NativeUiScale(){return native_ui_scale;}
+float SavedInteriorRatio(){(void)NativeStart();return std::isfinite(last_interior_ratio)?last_interior_ratio:saved_interior_ratio;}
+void ObserveInteriorRatio(float v){if(std::isfinite(v))last_interior_ratio=v;}
+void Pump() {
+  (void)NativeStart();
+  const auto committed=committed_system_distance.exchange(std::numeric_limits<float>::quiet_NaN(),std::memory_order_acquire);
+  if(std::isfinite(committed)){saved_system_distance=committed;Config::Get().default_system_zoom=committed_system_default.load();}
+  if(!initialized) {
+    initialized=true;
+    owner=true;
+    request=CreateEventW(nullptr,FALSE,FALSE,EventName(L"Save").c_str());
+    success=CreateEventW(nullptr,FALSE,FALSE,EventName(L"Saved").c_str());
+    failure=CreateEventW(nullptr,FALSE,FALSE,EventName(L"Failed").c_str());
+    if(!request||!success||!failure){owner=false;spdlog::error("[SettingsSave] Save command events unavailable");return;}
+    spdlog::info("[SettingsSave] Ready for Save button / F12; source is this account live configuration");
+  }
+  const bool pressed=!Key::IsInputFocused() && MapKey::IsDown(GameFunction::SaveSettings);
+  if(!owner||busy||(!pressed && WaitForSingleObject(request,0)!=WAIT_OBJECT_0))return;
+  ResetEvent(success);ResetEvent(failure);
+  try {
+    auto values=Snapshot();
+    const auto path=std::filesystem::path(std::string(File::MakePath(File::Config())));
+    busy=true;
+    try{std::thread(Save,std::move(values),path).detach();}catch(...){busy=false;throw;}
+  } catch(const std::exception& e){spdlog::error("[SettingsSave] Could not start save: {}",e.what());SetEvent(failure);}
+}
+}
+
+
+#else
+namespace single_settings {void ObserveNavigationZoom(int,float,float,float,float){} float SavedNavigationZoomDistance(int){return __builtin_nanf("");} void ObserveBlendZoom(int,float){} float SavedBlendZoom(int){return __builtin_nanf("");} void Pump(){} bool NativeStart(){return false;} bool NativePan(){return false;} void ObserveSystemZoom(float,float,float,float){} float SavedSystemZoomDistance(){return __builtin_nanf("");} void ClearSystemZoomOverride(){} void ObserveNativeUiScale(float){} float NativeUiScale(){return 1;} float SavedInteriorRatio(){return __builtin_nanf("");} void ObserveInteriorRatio(float){} }
+#endif
