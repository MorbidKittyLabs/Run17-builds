+#pragma once
+#include <cstdint>
+namespace manual_hold {
+struct Decision {bool request=false,cancel=false;};
+struct Gate {
+ bool armed=false,repeating=false;std::int64_t began=0,last=0;
+ Decision Tick(bool pressed,bool held,bool eligible,bool ready,std::int64_t now){
+  if(!eligible){bool cancel=armed||repeating;*this={};return {false,cancel};}
+  if(pressed){armed=held;repeating=false;began=last=now;return {true,false};}
+  if(!held){bool cancel=repeating;*this={};return {false,cancel};}
+  if(!armed)return {};
+  if(now-began>=400)repeating=true;
+  if(repeating&&ready&&now-last>=500){last=now;return {true,false};}
+  return {};
+ }
+};
+}
