@@ -0,0 +1,13 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace interior_zoom_policy {
+struct Extension {float minimum,maximum,progress;};
+inline Extension Evaluate(float minimum,float maximum,float ratio,float scale,bool far_source) {
+ if(!std::isfinite(minimum)||!std::isfinite(maximum)||!std::isfinite(ratio)||!std::isfinite(scale)||maximum<=minimum||scale<=1)
+  return {minimum,maximum,0};
+ const auto span=maximum-minimum;
+ return {far_source?minimum-span:minimum,far_source?maximum:maximum+span,
+         std::clamp(far_source?(minimum-ratio)/span:(ratio-maximum)/span,0.0f,1.0f)};
+}
+}
