+static void Run17DumpOccupiedMinerState(const char* tag, bool force = false)
+{
+  const auto signature = Run17StateSignature();
+  if (!force && signature == run17_diag_last_signature) {
+    return;
+  }
+  run17_diag_last_signature = signature;
+
+  const auto seq = ++run17_diag_seq;
+  const auto elapsed = Run17DiagElapsedMs();
+
+  std::ofstream diag(Run17DiagPath(), std::ios::app);
+  if (diag) {
+    diag << "[Run17Diag] seq=" << seq
+         << " t_ms=" << elapsed
+         << " tag=" << tag
+         << " " << signature << '\n';
+    diag.flush();
+  }
+
+  spdlog::info("[Run17Diag] seq={} t_ms={} tag={} {}", seq, elapsed, tag, signature);
+}
