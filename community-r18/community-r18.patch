@@ -0,0 +1,18 @@
+#pragma once
+#include <cmath>
+#include <algorithm>
+#include <optional>
+#include <cstdint>
+namespace system_zoom_save {
+struct Sample {
+ float distance=0,minimum=0,maximum=0,scale=0;
+ uint64_t observed_ms=0;
+ bool Valid() const {return std::isfinite(distance)&&std::isfinite(minimum)&&std::isfinite(maximum)&&std::isfinite(scale)&&distance>=0&&maximum>minimum&&scale>0;}
+ float Normalized() const {return (distance-minimum)/(maximum-minimum)*scale;}
+ bool Fresh(uint64_t now) const {return Valid()&&now>=observed_ms&&now-observed_ms<=1000;}
+};
+inline std::optional<float> Restore(float saved,float minimum,float maximum) {
+ if(!std::isfinite(saved)||saved<0||!std::isfinite(minimum)||!std::isfinite(maximum)||maximum<=minimum)return std::nullopt;
+ return std::clamp(saved,minimum,maximum);
+}
+}
diff --git a/mods/src/tactical_policy.h b/mods/src/tactical_policy.h
new file mode 100644
index 0000000..27fd7a2
--- /dev/null
+++ b/mods/src/tactical_policy.h
@@ -0,0 +1,97 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <optional>
+#include <string_view>
+#include <vector>
+namespace hostile_audit::tactical {
+struct Vec {double x=0,y=0,z=0;};
+inline Vec Sub(Vec a,Vec b){return {a.x-b.x,a.y-b.y,a.z-b.z};}
+inline double Dot(Vec a,Vec b){return a.x*b.x+a.y*b.y+a.z*b.z;}
+inline double Norm(Vec a){return std::sqrt(Dot(a,a));}
+inline bool Finite(Vec a){return std::isfinite(a.x)&&std::isfinite(a.y)&&std::isfinite(a.z);}
+inline bool Elite(std::string_view ref,std::string_view hull,bool explicit_flag=false) {
+ return explicit_flag || (ref=="91902" && hull.find("_Klg_Assassin_")!=std::string_view::npos);
+}
+class Motion {
+ struct Sample {int64_t time;Vec pos;};std::deque<Sample> samples;
+public:
+ void Add(int64_t now,Vec p) {
+  if(!Finite(p)){samples.clear();return;}
+  if(!samples.empty() && (now<=samples.back().time || now-samples.back().time>1500))samples.clear();
+  samples.push_back({now,p});
+  while(samples.size()>8 || (!samples.empty() && now-samples.front().time>1600))samples.pop_front();
+ }
+ std::optional<Vec> Velocity(int64_t now)const {
+  if(samples.size()<4 || now<samples.back().time || now-samples.back().time>750)return {};
+  const auto dt=samples.back().time-samples.front().time;if(dt<600)return {};
+  const auto delta=Sub(samples.back().pos,samples.front().pos);double path=0;
+  for(size_t i=1;i<samples.size();++i)path+=Norm(Sub(samples[i].pos,samples[i-1].pos));
+  if(path<0.01 || Norm(delta)/path<0.92)return {};
+  return Vec{delta.x*1000/dt,delta.y*1000/dt,delta.z*1000/dt};
+ }
+};
+inline std::optional<double> Intercept(Vec relative,Vec velocity,double own_speed) {
+ if(!Finite(relative)||!Finite(velocity)||!std::isfinite(own_speed)||own_speed<=0)return {};
+ const double c=Dot(relative,relative);if(c<1e-12)return 0.;
+ const double a=Dot(velocity,velocity)-own_speed*own_speed,b=2*Dot(relative,velocity);
+ double result=std::numeric_limits<double>::infinity();
+ if(std::abs(a)<1e-9){if(b<0)result=-c/b;}
+ else {
+  const double disc=b*b-4*a*c;
+  if(disc>=0) {
+   const double root=std::sqrt(disc);
+   // Stable quadratic roots avoid cancellation near the equal-speed case.
+   const double q=-.5*(b+std::copysign(root,b));
+   if(q!=0)for(const double t:{q/a,c/q})if(t>=0)result=std::min(result,t);
+  }
+ }
+ return std::isfinite(result)&&result<=30?std::optional<double>(result):std::nullopt;
+}
+struct Score {int64_t id=0;double distance2=-1;bool elite=false,trajectory_known=false;std::optional<double> eta;};
+struct Choice {int64_t id=0;bool intercept_mode=false;};
+inline Choice Choose(const std::vector<Score>& rows,int64_t incumbent=0) {
+ const Score* current=nullptr;bool elites=false;
+ for(const auto& r:rows)if(r.id>0 && std::isfinite(r.distance2)&&r.distance2>=0){elites|=r.elite;if(r.id==incumbent)current=&r;}
+ bool predicted=true,any_eta=false;size_t count=0;
+ for(const auto& r:rows)if(r.id>0 && std::isfinite(r.distance2)&&r.distance2>=0 && (!elites||r.elite)) {
+  ++count;predicted&=r.trajectory_known;any_eta|=r.eta.has_value();
+ }
+ predicted=predicted && any_eta && count>0;
+ const auto cost=[&](const Score& r){return predicted?r.eta.value_or(std::numeric_limits<double>::infinity()):r.distance2;};
+ const Score* best=nullptr;
+ for(const auto& r:rows) {
+  if(r.id<=0 || !std::isfinite(r.distance2)||r.distance2<0 || (elites&&!r.elite))continue;
+  if(!best || cost(r)<cost(*best) || (cost(r)==cost(*best) && r.id==incumbent)
+     || (cost(r)==cost(*best) && best->id!=incumbent && r.id<best->id))best=&r;
+ }
+ if(!best)return {incumbent,false};
+ if(!current || (best->elite&&!current->elite) || best->id==incumbent)return {best->id,predicted};
+ // Don't drop an elite for a nearer ordinary ship. Avoid small pursuit switches.
+ if(current->elite&&!best->elite)return {incumbent,predicted};
+ if(predicted) {
+  const auto old=cost(*current),next=cost(*best);
+  if(!std::isfinite(old) || (next<=old*.8 && old-next>=2))return {best->id,true};
+ }else if(best->distance2<current->distance2*.7225)return {best->id,false};
+ return {incumbent,predicted};
+}
+class QueueLatch {
+ bool queued=false;int64_t idle_since=-1;
+public:
+ bool Busy(int64_t now,bool combat,bool idle,std::optional<int> count,bool queue_disabled=false) {
+  if(count && *count>0){queued=true;idle_since=-1;return true;}
+  if(combat){idle_since=-1;return true;}
+  if(!count && !queue_disabled){idle_since=-1;return true;}
+  if(queued) {
+   if(!idle){idle_since=-1;return true;}
+   if(idle_since<0 || now<idle_since)idle_since=now;
+   if(now-idle_since<750)return true;
+   queued=false;
+  }
+  return false;
+ }
+};
+}
