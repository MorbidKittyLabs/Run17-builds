+std::filesystem::path Sibling(const char* suffix)
+{
+  auto path = std::filesystem::path(File::Log());
+  path.replace_filename(path.stem().string() + suffix);
+  return path;
+}
+void Write(Json record)
+{
+  try {
+    static auto logger = [] {
+      auto result = spdlog::rotating_logger_mt("hostile_target_audit", Sibling("_hostile_action.log").string(), 8*1024*1024, 2);
+      result->set_pattern("%v");
+      result->flush_on(spdlog::level::info);
+      return result;
+    }();
+    const auto epoch = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    static const auto session = std::to_string(epoch);
+    if(record.contains("target_id") && record["target_id"].is_string()) {
+      try {const auto id=std::stoll(record["target_id"].get<std::string>());const auto found=identities.find(id);
+        if(found!=identities.end())record["target_identity"]=found->second;
+      }catch(...){}
+    }
+    record["schema"] = "community-target-identity-v2";
+    record["time_unix_ms"] = epoch;
+    record["session"] = session;
+    logger->info("{}", record.dump());
+  } catch (...) { /* Diagnostics must not interrupt game actions. */ }
+}
+Il2CppObject* Object(void* value) { return static_cast<Il2CppObject*>(value); }
+struct Member {
+  FieldInfo* field = nullptr;
+  const MethodInfo* getter = nullptr;
+  const Il2CppType* type = nullptr;
+};
+Member Find(Il2CppObject* object, const char* name)
+{
+  if (!object) return {};
+  for (auto* cls = il2cpp_object_get_class(object); cls; cls = il2cpp_class_get_parent(cls)) {
+    if (auto* field = il2cpp_class_get_field_from_name(cls, name);
+        field && !(il2cpp_field_get_flags(field) & FIELD_ATTRIBUTE_STATIC))
+      return {field, nullptr, il2cpp_field_get_type(field)};
+    if (auto* property = il2cpp_class_get_property_from_name(cls, name)) {
+      auto* getter = il2cpp_property_get_get_method(const_cast<PropertyInfo*>(property));
+      if (getter && getter->parameters_count == 0 && !(getter->flags & METHOD_ATTRIBUTE_STATIC))
+        return {nullptr, getter, il2cpp_method_get_return_type(getter)};
+    }
+  }
+  return {};
+}
+Il2CppObject* ReadObject(Il2CppObject* object, const char* name)
+{
+  auto member = Find(object, name);
+  if (!member.type || member.type->byref
+      || (member.type->type != IL2CPP_TYPE_CLASS && member.type->type != IL2CPP_TYPE_OBJECT)) return nullptr;
+  if (member.field) {
+    Il2CppObject* value = nullptr;
+    il2cpp_field_get_value(object, member.field, &value);
+    return value;
+  }
+  Il2CppException* exception = nullptr;
+  auto* value = il2cpp_runtime_invoke(member.getter, object, nullptr, &exception);
+  return exception ? nullptr : value;
+}
+Json Scalar(Il2CppObject* object, const char* name)
+{
+  auto member = Find(object, name);
+  auto* type = member.type;
+  if (!type || type->byref) return nullptr;
+  if (type->type == IL2CPP_TYPE_VALUETYPE) {
+    auto* cls = il2cpp_class_from_type(type);
+    if (!cls || !il2cpp_class_is_enum(cls)) return nullptr;
+    type = il2cpp_class_enum_basetype(cls);
+  }
+  if (!type) return nullptr;
+  switch (type->type) {
+    case IL2CPP_TYPE_BOOLEAN: case IL2CPP_TYPE_I4: case IL2CPP_TYPE_U4:
+    case IL2CPP_TYPE_I8: case IL2CPP_TYPE_U8: case IL2CPP_TYPE_R4: case IL2CPP_TYPE_R8:
+    case IL2CPP_TYPE_STRING: break;
+    default: return nullptr;
+  }
+  alignas(uint64_t) uint64_t storage = 0;
+  const void* value = &storage;
+  if (member.field) il2cpp_field_get_value(object, member.field, &storage);
+  else {
+    Il2CppException* exception = nullptr;
+    auto* boxed = il2cpp_runtime_invoke(member.getter, object, nullptr, &exception);
+    if (exception || !boxed) return nullptr;
+    if (type->type == IL2CPP_TYPE_STRING) return to_string(reinterpret_cast<Il2CppString*>(boxed));
+    value = il2cpp_object_unbox(boxed);
+    if (!value) return nullptr;
+  }
+  switch (type->type) {
+    case IL2CPP_TYPE_BOOLEAN: return *static_cast<const bool*>(value);
+    case IL2CPP_TYPE_I4: return *static_cast<const int32_t*>(value);
+    case IL2CPP_TYPE_U4: return *static_cast<const uint32_t*>(value);
+    case IL2CPP_TYPE_I8: return std::to_string(*static_cast<const int64_t*>(value));
+    case IL2CPP_TYPE_U8: return std::to_string(*static_cast<const uint64_t*>(value));
+    case IL2CPP_TYPE_R4: {
+      const auto number=*static_cast<const float*>(value);
+      return std::isfinite(number) ? Json(number) : Json(nullptr);
+    }
+    case IL2CPP_TYPE_R8: {
+      const auto number=*static_cast<const double*>(value);
+      return std::isfinite(number) ? Json(number) : Json(nullptr);
+    }
+    case IL2CPP_TYPE_STRING: {
+      auto* text = *static_cast<Il2CppString* const*>(value);
+      return text ? Json(to_string(text)) : Json(nullptr);
+    }
+    default: return nullptr;
+  }
+}
+std::string Lower(std::string text)
+{
+  for (auto& ch : text) ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+  return text;
+}
+std::string TypeName(Il2CppClass* cls)
+{
+  if (!cls) return {};
+  return std::string(il2cpp_class_get_namespace(cls)) + "." + il2cpp_class_get_name(cls);
+}
+bool IsClass(Il2CppObject* object, const char* space, const char* name)
+{
+  if (object) for (auto* cls = il2cpp_object_get_class(object); cls; cls = il2cpp_class_get_parent(cls))
+    if (std::string(il2cpp_class_get_namespace(cls)) == space && std::string(il2cpp_class_get_name(cls)) == name)
+      return true;
+  return false;
+}
+// Resolve enum labels from the actual runtime enum, never assume protobuf numbers
+// match a similarly named game property.
+Json EnumLabel(Il2CppObject* object, const char* member_name)
+{
+  const auto member = Find(object, member_name);
+  if (!member.type || member.type->type != IL2CPP_TYPE_VALUETYPE) return nullptr;
+  auto* cls = il2cpp_class_from_type(member.type);
+  if (!cls || !il2cpp_class_is_enum(cls)) return nullptr;
+  auto* base = il2cpp_class_enum_basetype(cls);
+  const auto value = Scalar(object, member_name);
+  if (!base || (base->type != IL2CPP_TYPE_I4 && base->type != IL2CPP_TYPE_U4) || !value.is_number_integer())
+    return nullptr;
+  void* iterator = nullptr;
+  while (auto* field = il2cpp_class_get_fields(cls, &iterator)) {
+    if (!(il2cpp_field_get_flags(field) & FIELD_ATTRIBUTE_LITERAL)) continue;
+    int32_t literal = 0;
+    il2cpp_field_static_get_value(field, &literal);
+    if (value == literal) return il2cpp_field_get_name(field);
+  }
+  return nullptr;
+}
+Json FirstScalar(Il2CppObject* object,std::initializer_list<const char*> names)
+{
+  for(const auto* name:names){auto value=Scalar(object,name);if(!value.is_null())return value;}
+  return nullptr;
+}
+void IdentityInventory(Il2CppObject* object,const char* origin)
+{
+  static std::unordered_set<Il2CppClass*> seen;
+  if(!object || !seen.insert(il2cpp_object_get_class(object)).second)return;
+  Json fields=Json::array(),properties=Json::array();
+  for(auto* cls=il2cpp_object_get_class(object);cls;cls=il2cpp_class_get_parent(cls)){
+    void* iterator=nullptr;
+    while(auto* field=il2cpp_class_get_fields(cls,&iterator))
+      if(!(il2cpp_field_get_flags(field)&FIELD_ATTRIBUTE_STATIC))fields.push_back({{"name",il2cpp_field_get_name(field)},{"type",TypeName(il2cpp_class_from_type(il2cpp_field_get_type(field)))}});
+    iterator=nullptr;
+    while(auto* property=il2cpp_class_get_properties(cls,&iterator))properties.push_back(il2cpp_property_get_name(const_cast<PropertyInfo*>(property)));
+  }
+  Write({{"event","target_identity_inventory"},{"origin",origin},{"type",TypeName(il2cpp_object_get_class(object))},{"fields",fields},{"properties",properties}});
+}
+void CaptureIdentity(FleetDeployedData* target)
+{
+  if(!target)return;
+  const auto id=target->GetId64();if(id<=0 || identities.contains(id))return;
+  auto* object=Object(target);auto* hull=ReadObject(object,"Hull");
+  auto* deployed=ReadObject(object,"DeployedFleet");if(!deployed)deployed=ReadObject(object,"_deploymentFleet");
+  IdentityInventory(hull,"Hull");IdentityInventory(deployed,"DeployedFleet");
+  const auto name=FirstScalar(object,{"Name","DisplayName"});
+  const auto hull_name=FirstScalar(hull,{"Name","name_"});
+  Json raw=Json::object();
+  // Record only named identity/classification scalars; never dump object memory.
+  for(const auto* key:{"Id","id_","RefId","refId_","HullId","hullId_","MarauderId","marauderId_","NpcId","npcId_","Level","level_","Name","name_","IsElite","IsScout","Rank","rank_","LocaId","locaId_","SpecId","specId_"}){
+    const auto value=Scalar(deployed,key);if(!value.is_null())raw[key]=value;
+  }
+  Json identity={{"name",name},{"hull_name",hull_name},
+    {"hull_id",FirstScalar(object,{"HullId"})},{"hull_spec_id",FirstScalar(hull,{"Id","id_"})},
+    {"hull_id_string",FirstScalar(hull,{"IdStr","idStr_"})},
+    {"level",Scalar(object,"Level")},{"strength",Scalar(object,"Strength")},
+    {"fleet_type",Scalar(object,"FleetType")},{"fleet_type_label",EnumLabel(object,"FleetType")},
+    {"hull_type",Scalar(hull,"Type")},{"hull_type_label",EnumLabel(hull,"Type")},
+    {"ref_id",Scalar(object,"RefId")},{"icon_identifier",Scalar(object,"IconIdentifier")},
+    {"is_elite",Scalar(object,"IsElite")},{"is_scout",Scalar(object,"IsScout")},
+    {"deployment_identifiers",raw},{"category","unknown"},
+    {"priority",0},{"priority_reason","nearest_eligible; classification retained as raw evidence; tactical ranking logged separately"}};
+  // Text is evidence for investigation, not a fabricated elite/scout flag.
+  std::string text;
+  if(name.is_string())text+=name.get<std::string>();
+  if(hull_name.is_string())text+=" "+hull_name.get<std::string>();
+  text=Lower(text);
+  identity["category_hint"]=text.find("elite")!=std::string::npos && text.find("assassin")!=std::string::npos?"elite_assassin":text.find("scout")!=std::string::npos?"scout":"unknown";
+  identity["classification_source"]="runtime named properties/fields; null means unavailable";
+  identities[id]=std::move(identity);
+  Write({{"event","target_identified"},{"target_id",std::to_string(id)}});
+}
+Json TargetMetadata(FleetDeployedData* target)
+{
+  CaptureIdentity(target);
+  auto* object = Object(target);
+  static std::unordered_set<Il2CppClass*> described;
+  if (object && described.insert(il2cpp_object_get_class(object)).second) {
+    Json fields = Json::array();
+    Json properties = Json::array();
+    for (auto* cls = il2cpp_object_get_class(object); cls; cls = il2cpp_class_get_parent(cls)) {
+      void* iterator = nullptr;
+      while (auto* field = il2cpp_class_get_fields(cls, &iterator))
+        if (!(il2cpp_field_get_flags(field) & FIELD_ATTRIBUTE_STATIC))
+          fields.push_back({{"name", il2cpp_field_get_name(field)},
+                            {"type", TypeName(il2cpp_class_from_type(il2cpp_field_get_type(field)))}});
+      iterator = nullptr;
+      while (auto* property = il2cpp_class_get_properties(cls, &iterator))
+        properties.push_back(il2cpp_property_get_name(const_cast<PropertyInfo*>(property)));
+    }
+    Write({{"event", "target_model_inventory"}, {"fields", fields}, {"properties", properties}});
+  }
+  auto* address = ReadObject(object, "Address");
+  auto node = Scalar(object, "NodeId");
+  if (node.is_null()) node = Scalar(address, "NodeId");
+  return {{"state", Scalar(object, "State")}, {"state_label", EnumLabel(object, "State")},
+          {"current_state", Scalar(object, "CurrentState")},
+          {"current_state_label", EnumLabel(object, "CurrentState")},
+          {"is_active", Scalar(object, "IsActive")}, {"system_node_id", node},
+          {"is_destroyed", Scalar(object, "IsDestroyed")}, {"static", Scalar(object, "Static")},
+          {"currently_battling", Scalar(object, "CurrentlyBattling")},
+          {"hull_damage", Scalar(object, "HullDamage")}, {"shield_damage", Scalar(object, "ShieldDamage")},
+          {"cause_of_destruction", Scalar(object, "CauseOfDestruction")}};
+}
+bool TargetIdle(const Json& metadata)
+{
+  for (const char* key : {"state_label", "current_state_label"}) {
+    if (!metadata[key].is_string()) continue;
+    const auto label = Lower(metadata[key].get<std::string>());
+    return label == "idle" || label == "idleinspace";
+  }
+  return false;
+}
+
+struct ButtonResult { Attack state = Attack::Unknown; Json details = Json::object(); };
+Il2CppObject* ButtonContext(Il2CppObject* control)
+{
+  if (auto* context=ReadObject(control, "Context"); IsClass(context, "Digit.Client.UI", "GenericButtonContext"))
+    return context;
+  // A closed generic Widget<T> may expose a generic-parameter return type.
+  // Invoke the property safely and verify the resulting object's actual class.
+  const auto member=Find(control, "Context");
+  if (!member.getter) return nullptr;
+  Il2CppException* exception=nullptr;
+  auto* value=il2cpp_runtime_invoke(member.getter, control, nullptr, &exception);
+  return !exception && IsClass(value, "Digit.Client.UI", "GenericButtonContext") ? value : nullptr;
+}
+ButtonResult InspectButton(Il2CppObject* control)
+{
+  ButtonResult result;
+  if (!control) return result;
+  result.details["type"] = TypeName(il2cpp_object_get_class(control));
+  auto* listener=ReadObject(control, "_semaphoreButtonListener");
+  const auto widget_active=Scalar(control, "isActiveAndEnabled");
+  const auto listener_interactable=Scalar(listener, "Interactable");
+  const auto context_interactable=Scalar(ButtonContext(control), "Interactable");
+  result.details["widget_active"]=widget_active;
+  result.details["listener_interactable"]=listener_interactable;
+  result.details["context_interactable"]=context_interactable;
+  auto* unity_button=ReadObject(listener, "_button");
+  if (IsClass(unity_button, "UnityEngine.UI", "Button")) {
+    const auto active=Scalar(unity_button, "isActiveAndEnabled");
+    auto interactable=Scalar(unity_button, "interactable");
+    for (auto* cls=il2cpp_object_get_class(unity_button); cls; cls=il2cpp_class_get_parent(cls)) {
+      const auto* method=il2cpp_class_get_method_from_name(cls, "IsInteractable", 0);
+      if (!method || (method->flags & METHOD_ATTRIBUTE_STATIC)
+          || il2cpp_method_get_return_type(method)->type != IL2CPP_TYPE_BOOLEAN) continue;
+      Il2CppException* exception=nullptr;
+      auto* boxed=il2cpp_runtime_invoke(method, unity_button, nullptr, &exception);
+      auto* value=!exception && boxed ? static_cast<bool*>(il2cpp_object_unbox(boxed)) : nullptr;
+      if (value) interactable=*value;
+      break;
+    }
+    result.details["button_active"]=active;
+    result.details["button_interactable"]=interactable;
+    result.details["usability_source"]="UnityEngine.UI.Button";
+    if (widget_active == true && active == true && interactable.is_boolean())
+      result.state=interactable == true ? Attack::Usable : Attack::Disabled;
+    return result;
+  }
+  // These are typed signals from the exact GenericButtonWidget, never from a
+  // label or event object. Explicitly disabled signals override usable signals.
+  result.details["usability_source"]="GenericButtonWidget_context_or_listener";
+  if (widget_active == true) {
+    if (listener_interactable == false || context_interactable == false) result.state=Attack::Disabled;
+    else if (listener_interactable == true || context_interactable == true) result.state=Attack::Usable;
+  }
+  return result;
+}
+ButtonResult AttackButton(ScanEngageButtonsWidget* buttons)
+{
+  auto* object=Object(buttons);
+  auto* control=ReadObject(object, "_engageButton");
+  ButtonResult result;
+  static std::unordered_set<Il2CppClass*> described;
+  if (object && described.insert(il2cpp_object_get_class(object)).second) {
+    Json fields=Json::array();
+    for (auto* cls=il2cpp_object_get_class(object); cls; cls=il2cpp_class_get_parent(cls)) {
+      void* iterator=nullptr;
+      while (auto* field=il2cpp_class_get_fields(cls, &iterator)) {
+        if (il2cpp_field_get_flags(field) & FIELD_ATTRIBUTE_STATIC) continue;
+        const auto name=Lower(il2cpp_field_get_name(field));
+        if (name.find("engage") != std::string::npos || name.find("attack") != std::string::npos)
+          fields.push_back({{"field", il2cpp_field_get_name(field)},
+                            {"type", TypeName(il2cpp_class_from_type(il2cpp_field_get_type(field)))}});
+      }
+    }
+    Write({{"event", "attack_control_inventory"}, {"fields", fields}, {"selected_field", "_engageButton"}});
+  }
+  if (IsClass(control, "Digit.Client.UI", "GenericButtonWidget")) result=InspectButton(control);
+  else result.details["binding"]="exact_engage_button_unavailable_or_wrong_type";
+  result.details["field"]="_engageButton";
+  result.details["container_active"]=Scalar(object, "isActiveAndEnabled");
+  const auto ignored=Scalar(object, "_ignoreEngageClick");
+  result.details["ignore_engage_click"]=ignored;
+  result.details["engage_blocker_state"]=Scalar(object, "_currentEngageBlockerState");
+  if (ignored == true) result.state=Attack::Unknown;
+  return result;
+}
