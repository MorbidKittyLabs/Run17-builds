--- /dev/null
+++ b/mods/src/community_loading_policy.h
@@ -0,0 +1,30 @@
+#pragma once
+#include "toml_editor.h"
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace community_loading {
+inline std::string Restore(const std::string& original) {
+ using namespace config_edit;
+ const auto before=toml::parse(original);
+ if(before["community_saved"]["morbid_native_loading_v1"].value_or(false))return original;
+ struct Setting {const char* section;const char* key;Value value;};
+ const std::vector<Setting> settings={
+  {"graphics","loader_enabled",false},{"graphics","loader_transition",false},
+  {"graphics","loader_transition_black",true},{"graphics","loader_tip_enabled",false},
+  {"graphics","loader_image",std::string{}},{"graphics","loader_logo_scale",1.0},
+  {"patches","loadingscreenhooks",true},{"patches","transitionscreenhooks",true},
+  {"patches","loadingtiphooks",true},{"community_saved","morbid_native_loading_v1",true}
+ };
+ std::string current=original;TomlEditor editor;
+ for(const auto& setting:settings){
+  const auto parsed=toml::parse(current);const auto* section=parsed.get_as<toml::table>(setting.section);
+  const auto* node=section?section->get(setting.key):nullptr;std::optional<Value> expected;
+  if(node){if(node->is_boolean())expected=node->as_boolean()->get();else if(node->is_string())expected=node->as_string()->get();else if(node->is_integer())expected=node->as_integer()->get();else if(node->is_floating_point())expected=node->as_floating_point()->get();else throw std::runtime_error("Unsupported loading setting type");}
+  const auto edit=editor.Prepare(current,{setting.section,setting.key,expected,setting.value});
+  if(edit.outcome==Outcome::Prepared)current=edit.text;else if(edit.outcome!=Outcome::AlreadySaved)throw std::runtime_error("Loading configuration update rejected");
+ }
+ (void)toml::parse(current);return current;
+}
+}
