+// Select the occupant only when we are deliberately moving from the mining
+// presentation to the cargo/rewards presentation. STFC then owns the native
+// ship card, rewards panel, Scan button, and Attack button.
+static bool Run17OpenOccupiedMinerLoot(MiningObjectViewerWidget* mine, const char* reason)
+{
+  auto* visibility = mine ? mine->_visibilityController : nullptr;
+  const bool mine_visible = visibility
+                            && (visibility->_state == VisibilityState::Visible
+                                || visibility->_state == VisibilityState::Show);
+  if (!mine_visible) {
+    return false;
+  }
+
+  const auto occupant_id = Run17OccupiedMinerId(mine);
+  if (occupant_id <= 0) {
+    run17_occupied_miner_id = 0;
+    return false;
+  }
+
+  auto* sections = NavigationSectionManager::Instance();
+  auto* navigation = sections ? sections->SNavigationManager : nullptr;
+  if (!navigation) {
+    spdlog::info("[Run17 OccupiedMiner] navigation unavailable");
+    return false;
+  }
+
+  const bool can_select = navigation->CanSelectPoi(occupant_id);
+  const bool selected = can_select && navigation->SelectPoi(occupant_id);
+  spdlog::info("[Run17 OccupiedMiner] {} occupant={} can_select={} selected={}",
+               reason, occupant_id, can_select, selected);
+  if (selected) {
+    run17_occupied_miner_id = occupant_id;
+    // Reveal the native rewards panel after the player target card binds.
+    show_info_pending = 5;
+  }
+  return selected;
+}
+
+// Occupied-miner presentation: node -> cargo/rewards <-> ship strength.
+// Returning to the mining-node card is unresolved in this baseline.
+// All three are native STFC presentations and retain their native Scan/Attack
+// controls. This function only takes over while the tracked target is the fleet
+// occupying the mining node.
+static bool Run17CycleOccupiedMinerView(bool pressed)
+{
+  if (!pressed) {
+    return false;
+  }
+
+  auto* mine = ObjectFinder<MiningObjectViewerWidget>::Get();
+  auto* mine_visibility = mine ? mine->_visibilityController : nullptr;
+  const bool mine_visible = mine_visibility
+                            && (mine_visibility->_state == VisibilityState::Visible
+                                || mine_visibility->_state == VisibilityState::Show);
+
+  if (mine_visible) {
+    return Run17OpenOccupiedMinerLoot(mine, "mine->loot");
+  }
+
+  if (run17_occupied_miner_id <= 0 || !mine || !mine_visibility) {
+    return false;
+  }
+
+  // The hidden mining viewer must still be bound to the same occupying fleet.
+  // Never restore a stale pooled mining card.
+  const auto mine_occupant_id = Run17OccupiedMinerId(mine);
+  if (mine_occupant_id > 0 && mine_occupant_id != run17_occupied_miner_id) {
+    run17_occupied_miner_id = 0;
+    return false;
+  }
+
+  for (auto* pre_scan_widget : ObjectFinder<PreScanTargetWidget>::GetAll()) {
+    auto* visibility = pre_scan_widget ? pre_scan_widget->_visibilityController : nullptr;
+    const bool ship_visible = visibility
+                              && (visibility->_state == VisibilityState::Visible
+                                  || visibility->_state == VisibilityState::Show);
+    if (!ship_visible) {
+      continue;
+    }
+
+    auto* buttons = pre_scan_widget->_scanEngageButtonsWidget;
+    auto* battle = buttons ? buttons->Context : nullptr;
+    auto* target = battle ? battle->TargetFleetDeployedData : nullptr;
+    if (!target || target->GetId64() != run17_occupied_miner_id) {
+      continue;
+    }
+
+    auto* rewards_widget = pre_scan_widget->_rewardsButtonWidget;
+    auto* rewards_controller = rewards_widget ? rewards_widget->_rewardsController : nullptr;
+    const bool rewards_visible = rewards_controller
+                                 && (rewards_controller->_state == VisibilityState::Visible
+                                     || rewards_controller->_state == VisibilityState::Show);
+    if (rewards_visible) {
+      // Let the normal ActionView code handle loot -> ship strength.
+      return false;
+    }
+
+    // Mine is intentionally a one-time presentation. From ship strength,
+    // let the normal ActionView path reopen cargo/rewards.
+    return false;
+  }
+
+  return false;
+}

