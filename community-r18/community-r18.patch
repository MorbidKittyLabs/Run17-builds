+#pragma once
+#include <cmath>
+#include <optional>
+
+namespace fleet_diagnostics::diagnostics {
+inline std::optional<double> NonNegative(std::optional<double> value) {
+  return value && std::isfinite(*value) && *value >= 0 ? value : std::nullopt;
+}
+struct CargoSample {
+  std::optional<double> fill_fraction, current, protected_limit;
+  std::optional<bool> over_protected;
+  static CargoSample Read(std::optional<double> fill, std::optional<double> amount,
+                          std::optional<double> protected_amount) {
+    CargoSample sample{NonNegative(fill), NonNegative(amount), NonNegative(protected_amount), std::nullopt};
+    if (sample.fill_fraction && *sample.fill_fraction > 1) sample.fill_fraction.reset();
+    if (sample.current && sample.protected_limit)
+      sample.over_protected = *sample.current > *sample.protected_limit;
+    return sample;
+  }
+};
+} // namespace fleet_diagnostics::diagnostics
