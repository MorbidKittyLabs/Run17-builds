@@ -0,0 +1,17 @@
+#pragma once
+#include <string_view>
+
+namespace LoaderPolicy {
+// Windows preserves the launch path's spelling even on a case-insensitive volume.
+// Keep upstream's prime-prefix support, accepting every ASCII case spelling.
+constexpr bool IsPrimeExecutableName(std::wstring_view name) noexcept
+{
+  constexpr std::wstring_view prefix = L"prime";
+  if (name.size() < prefix.size()) return false;
+  for (size_t i = 0; i < prefix.size(); ++i) {
+    const auto c = name[i] >= L'A' && name[i] <= L'Z' ? name[i] + (L'a' - L'A') : name[i];
+    if (c != prefix[i]) return false;
+  }
+  return true;
+}
+}
