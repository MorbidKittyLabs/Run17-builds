diff --git a/mods/src/patches/parts/hostile_action.cc b/mods/src/patches/parts/hostile_action.cc
new file mode 100644
index 0000000..88f8c99
--- /dev/null
+++ b/mods/src/patches/parts/hostile_action.cc
@@ -0,0 +1,306 @@
+#include "patches/parts/hostile_action.h"
+#include "patches/parts/hostile_target_audit.h"
+#include "errormsg.h"
+#include "manual_hold_policy.h"
+
+
+#include "prime/FleetBarViewController.h"
+#include "prime/FleetLocalViewController.h"
+#include "prime/Hub.h"
+#include "prime/NavigationSectionManager.h"
+#include "prime/ObjectViewerBaseWidget.h"
+#include "prime/ScanEngageButtonsWidget.h"
+#include "prime/PreScanTargetWidget.h"
+#include "prime/VisibilityController.h"
+
+#include <algorithm>
+#include <chrono>
+#include <string>
+#include <cmath>
+#include <unordered_map>
+
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+using hostile_audit::ProbeStatus;
+using hostile_audit::EngageDecision;
+int64_t NowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count();
+}
+struct Pursuit {
+  hostile_audit::TargetPursuit target;
+  uint64_t attempt = 0;
+  hostile_audit::EngageWindow window;
+  ProbeStatus last_status = ProbeStatus::MissingPanel;
+  bool status_logged = false;
+  bool awaiting_attack = false;
+  bool compare_requested = false;
+  int64_t next_update = 0, last_retained_log = 0;
+};
+std::unordered_map<uint64_t, Pursuit> pursuits;
+const char* StatusName(ProbeStatus status)
+{
+  switch (status) {
+    case ProbeStatus::MissingPanel: return "matching_card_not_ready";
+    case ProbeStatus::UnknownButton: return "attack_button_not_verified_usable";
+    case ProbeStatus::DisabledButton: return "attack_button_disabled";
+    case ProbeStatus::UnknownMotion: return "waiting_for_fresh_model_movement";
+    case ProbeStatus::Stationary: return "target_stationary";
+    case ProbeStatus::Invalid: return "target_invalid_or_destroyed";
+    case ProbeStatus::Ready: return "matching_attack_ready";
+  }
+  return "unknown";
+}
+struct Probe {
+  ProbeStatus status = ProbeStatus::MissingPanel;
+  ScanEngageButtonsWidget* buttons = nullptr; // current update only; never retained
+};
+
+bool InSystem()
+{
+  auto* sections = Hub::get_SectionManager();
+  return sections && sections->CurrentSection == SectionID::Navigation_System;
+}
+
+FleetPlayerData* SelectedFleet(FleetBarViewController* bar)
+{
+  auto* controller = bar ? bar->_fleetPanelController : nullptr;
+  return controller ? controller->fleet : nullptr;
+}
+
+// The exact target card and exact engage control must both be usable. No
+// ActionPrimary fallback: it can issue unrelated contextual actions.
+Probe ProbeMatchingTarget(int64_t target_id, FleetPlayerData* own, uint64_t attempt)
+{
+  for (auto* viewer : ObjectFinder<PreScanTargetWidget>::GetAll()) {
+    auto* visibility = viewer ? viewer->_visibilityController : nullptr;
+    if (!visibility || (visibility->_state != VisibilityState::Visible && visibility->_state != VisibilityState::Show))
+      continue;
+    auto* buttons = viewer->_scanEngageButtonsWidget;
+    auto* battle = buttons ? buttons->Context : nullptr;
+    auto* target = battle ? battle->TargetFleetDeployedData : nullptr;
+    if (!target || target->GetId64() != target_id) continue;
+    DeployedFleetType fleet_type{};
+    auto* hull = target->Hull;
+    if (!target->TryGetFleetType(fleet_type) || !hull) return {};
+    if (fleet_type != DeployedFleetType::Marauder || hull->Type == HullType::ArmadaTarget)
+      return {ProbeStatus::Invalid};
+    const auto attack = hostile_audit::ObserveButton(buttons, target, own, attempt);
+    if (hostile_audit::KnownDestroyed(target)) return {ProbeStatus::Invalid};
+    const auto motion = hostile_audit::CurrentMotion(target_id);
+    if (motion == hostile_audit::Motion::Stationary) return {ProbeStatus::Stationary};
+    if (motion != hostile_audit::Motion::Moving) return {ProbeStatus::UnknownMotion};
+    if (!buttons->isActiveAndEnabled || attack == hostile_audit::Attack::Unknown)
+      return {ProbeStatus::UnknownButton};
+    if (attack == hostile_audit::Attack::Disabled) return {ProbeStatus::DisabledButton};
+    return {ProbeStatus::Ready, buttons};
+  }
+  return {};
+}
+} // namespace
+
+void CancelSelectAttackHostile(const char* reason)
+{
+  for (const auto& [own, pursuit] : pursuits) {
+    if (pursuit.target.Target())
+      hostile_audit::Record("pursuit_cancelled", pursuit.target.Target(), own, reason);
+  }
+  pursuits.clear();
+}
+
+void UpdateSelectAttackHostile(FleetBarViewController* bar, bool pressed)
+{
+  auto* own_fleet = SelectedFleet(bar);
+  if (!InSystem() || !own_fleet || own_fleet->Id == 0) {
+    if (pressed) hostile_audit::Record("press_skipped", 0, 0, "system view or selected ship unavailable");
+    CancelSelectAttackHostile("left system view or lost selected ship");
+    return;
+  }
+  const auto own_id = own_fleet->Id;
+  if(pressed)CancelSelectAttackHostile("new manual request");
+  else if(!pursuits.contains(own_id)) {
+    CancelSelectAttackHostile("selected ship changed or no manual request");
+    return;
+  }
+  const auto own_state = own_fleet->CurrentState;
+  auto& pursuit = pursuits[own_id];
+  const auto now = NowMs();
+  std::string pause;
+  const auto suspend = [&]() {
+    CancelSelectAttackHostile("manual request blocked by combat or queue");
+  };
+  if (hostile_audit::TacticalBusy(own_fleet,pause)) {suspend();return;}
+  if (own_state == FleetState::Battling) {
+    if (pursuit.target.Target()) pursuit.target.ObserveCombat();
+    if (pressed) hostile_audit::Record("press_ignored_during_observed_combat", pursuit.target.Target(), own_id);
+    return;
+  }
+  if (pursuit.target.CombatSeen()) {
+    if (own_state == FleetState::Unknown) return;
+    hostile_audit::Record("pursuit_combat_finished", pursuit.target.Target(), own_id);
+    pursuit = {};
+  }
+  pursuit.compare_requested = pursuit.compare_requested || pressed;
+  if (!pursuit.target.Target() && !pursuit.compare_requested) return;
+  if (now < pursuit.next_update) return;
+  pursuit.next_update = now + hostile_audit::EngageWindow::ProbeEveryMs;
+
+  auto* sections = NavigationSectionManager::Instance();
+  auto* navigation = sections ? sections->SNavigationManager : nullptr;
+  if (!navigation) return;
+  auto ids = VisibleRegularHostileIds();
+  std::sort(ids.begin(), ids.end());
+  ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+  auto release = [&](const char* reason) {
+    hostile_audit::Record("pursuit_released", pursuit.target.Target(), own_id, reason);
+    const auto requested = pursuit.compare_requested;
+    pursuit = {};
+    pursuit.compare_requested = requested;
+  };
+  auto position = [](int64_t id, hostile_audit::Position& result) {
+    float x=0, y=0, z=0;
+    if (!TryVisibleFleetSystemPosition(id,x,y,z) || !std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z))
+      return false;
+    result={x,y,z};
+    return true;
+  };
+  hostile_audit::Position own_position{}, target_position{};
+  const bool own_position_ok = position(static_cast<int64_t>(own_id), own_position);
+  double current_distance2 = -1;
+  if (const auto id = pursuit.target.Target()) {
+    const bool visible = std::binary_search(ids.begin(),ids.end(),id);
+    const auto motion = hostile_audit::CurrentMotion(id);
+    if (hostile_audit::Blocked(id,own_id)) {
+      release("target excluded or engagement failed");
+    } else if (visible && VisibleHostileKnownDestroyed(id)) {
+      hostile_audit::Cooldown(id,own_id,"target_destroyed",30000);
+      release("target confirmed destroyed");
+    } else if (visible && motion == hostile_audit::Motion::Stationary) {
+      hostile_audit::Cooldown(id,own_id,"target_confirmed_stationary",2000);
+      release("target confirmed stationary");
+    } else if (!visible || !own_position_ok || !position(id,target_position)) {
+      // Missing/stale observations do not make a farther candidate nearer.
+      // Retain the target briefly through widget rebinding, then recover if it
+      // remains unavailable. No attack or retarget is issued in this interval.
+      if (!pursuit.target.MissingExpired(now)) return;
+      release("target or model position unavailable for 3000 ms");
+    } else {
+      pursuit.target.Seen();
+      current_distance2 = hostile_audit::Distance2(own_position,target_position);
+    }
+  }
+  if (!own_position_ok) {
+    if (pressed) hostile_audit::Record("press_skipped",0,own_id,"selected ship model position unavailable");
+    return;
+  }
+
+  const bool compare_requested = pursuit.compare_requested;
+  pursuit.compare_requested = false;
+  if (compare_requested) {
+    std::vector<hostile_audit::RankedTarget> candidates;
+    for (const auto id : ids) {
+      if (id == pursuit.target.Target() || hostile_audit::Skip(id,own_id) || !navigation->CanSelectPoi(id)) continue;
+      hostile_audit::Position other;
+      if (position(id,other)) candidates.push_back({id,hostile_audit::Distance2(own_position,other)});
+    }
+    // A failed SelectPoi must not permit a farther fallback during a valid
+    // pursuit. Every alternative is compared to the same incumbent distance.
+    while (const auto candidate = hostile_audit::TacticalChoose(candidates,pursuit.target.Target(),current_distance2,own_id)) {
+      if (candidate == pursuit.target.Target()) break;
+      if (hostile_audit::TacticalBusy(own_fleet,pause,true)) {suspend();return;}
+      if (navigation->SelectPoi(candidate)) {
+        const auto found = std::find_if(candidates.begin(),candidates.end(),
+            [candidate](const auto& value) { return value.id == candidate; });
+        const auto distance = found->distance2;
+        if (pursuit.target.Target()) {
+          const auto detail = std::string("previous_target=")+std::to_string(pursuit.target.Target())
+              +"; previous_distance2="+std::to_string(current_distance2)
+              +"; new_distance2="+std::to_string(distance);
+          hostile_audit::Record("pursuit_switched_tactical",candidate,own_id,detail.c_str());
+        }
+        pursuit = {};
+        pursuit.target.Select(candidate);
+        pursuit.attempt = hostile_audit::Selected(candidate,own_fleet,distance);
+        pursuit.window.Begin(now);
+        pursuit.awaiting_attack = true;
+        return; // let the matching card populate on subsequent game updates
+      }
+      candidates.erase(std::remove_if(candidates.begin(),candidates.end(),
+          [candidate](const auto& value) { return value.id == candidate; }),candidates.end());
+    }
+    if (!pursuit.target.Target()) {
+      hostile_audit::Record("no_eligible_hostile_selected",0,own_id);
+      return;
+    }
+    if (now-pursuit.last_retained_log >= 1000) {
+      const auto detail = std::string("distance2=")+std::to_string(current_distance2)
+          +"; source=FleetDeployedData.SystemPosition; elite_priority_then_intercept_or_nearest_with_hysteresis";
+      hostile_audit::Record("pursuit_kept_current_target",pursuit.target.Target(),own_id,detail.c_str());
+      pursuit.last_retained_log = now;
+    }
+  }
+  if (!pursuit.target.Target()) return;
+
+  if (hostile_audit::TacticalBusy(own_fleet,pause,true)) {suspend();return;}
+  if (!pursuit.awaiting_attack) {
+    // Accepted pursuit/travel is retained across repeats. An idle ship may
+    // retry this SAME target at a bounded rate; the existing observed-state
+    // watchdog still detects a handler that never actually engaged.
+    if (!compare_requested || own_state != FleetState::IdleInSpace || !pursuit.target.RetryDue(now)) return;
+    pursuit.attempt = hostile_audit::Selected(pursuit.target.Target(),own_fleet,current_distance2);
+    const auto probe = ProbeMatchingTarget(pursuit.target.Target(),own_fleet,pursuit.attempt);
+    if (probe.status == ProbeStatus::MissingPanel) navigation->SelectPoi(pursuit.target.Target());
+    pursuit.window.Begin(now);
+    pursuit.awaiting_attack = true;
+    pursuit.status_logged = false;
+  }
+  const auto probe = ProbeMatchingTarget(pursuit.target.Target(),own_fleet,pursuit.attempt);
+  const auto evaluated_at = NowMs();
+  const auto decision = pursuit.window.Decide(evaluated_at,probe.status);
+  if (!pursuit.status_logged || pursuit.last_status != probe.status) {
+    hostile_audit::Record("pending_probe_state",pursuit.target.Target(),own_id,StatusName(probe.status));
+    pursuit.last_status = probe.status;
+    pursuit.status_logged = true;
+  }
+  if (decision == EngageDecision::Dispatch && probe.buttons) {
+    auto* current_own = SelectedFleet(bar);
+    auto* battle = probe.buttons->Context;
+    auto* target = battle ? battle->TargetFleetDeployedData : nullptr;
+    if (!current_own || current_own->Id != own_id || !target || target->GetId64() != pursuit.target.Target()) {
+      release("ship or target context changed during confirmation");
+      return;
+    }
+    if (hostile_audit::TacticalBusy(current_own,pause,true)) {suspend();return;}
+    // Capture before native dispatch, which can synchronously change ship state.
+    hostile_audit::TacticalDispatched(pursuit.target.Target(),current_own);
+    probe.buttons->OnEngageButtonClicked();
+    hostile_audit::Dispatched(pursuit.target.Target(),own_fleet,pursuit.attempt);
+    // The explicit user request is complete. Another attack requires another F6 press.
+    pursuits.erase(own_id);
+  } else if (decision == EngageDecision::Stale || decision == EngageDecision::Reject
+             || decision == EngageDecision::Timeout) {
+    const auto duration = probe.status == ProbeStatus::Stationary || decision == EngageDecision::Stale ? 2000
+                          : probe.status == ProbeStatus::Invalid || probe.status == ProbeStatus::DisabledButton ? 30000 : 15000;
+    hostile_audit::Cooldown(pursuit.target.Target(),own_id,StatusName(probe.status),duration);
+    release(StatusName(probe.status));
+  }
+}
+
+namespace {manual_hold::Gate held_gate;uint64_t held_ship=0;}
+void ResetHeldSelectAttackHostile(){held_gate={};held_ship=0;CancelSelectAttackHostile("held input interrupted");}
+void UpdateHeldSelectAttackHostile(FleetBarViewController* bar,bool pressed,bool held,bool eligible){
+ auto* own=SelectedFleet(bar);eligible=eligible&&InSystem()&&own&&own->Id;
+ if(pressed&&own)held_ship=own->Id;
+ if(held_ship&&own&&held_ship!=own->Id){ResetHeldSelectAttackHostile();pressed=false;}
+ const auto pending=own?pursuits.find(own->Id):pursuits.end();
+ const bool awaiting=pending!=pursuits.end()&&pending->second.awaiting_attack;
+ std::string reason;const bool ready=eligible&&own->CurrentState==FleetState::IdleInSpace&&!awaiting&&!hostile_audit::TacticalBusy(own,reason);
+ const auto decision=held_gate.Tick(pressed,held,eligible,ready,NowMs());
+ if(decision.cancel)CancelSelectAttackHostile("held input released or unavailable");
+ if(!held&&!pressed)held_ship=0;
+ if(eligible)UpdateSelectAttackHostile(bar,decision.request);
+ else CancelSelectAttackHostile("manual input unavailable");
+}
