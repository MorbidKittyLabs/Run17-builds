index 0000000..e490eba
--- /dev/null
+++ b/mods/src/station_diagnostics.inc
@@ -0,0 +1,211 @@
+// Included inside fleet_diagnostics's anonymous namespace. Game-thread reads only.
+// Reuse tracked native station cards. Never retain managed pointers or invoke actions.
+std::string station_snapshot_key;
+Json station_last_snapshot=nullptr;
+uint64_t station_heartbeat=0;
+std::set<Il2CppClass*> station_described;
+int station_model_budget=0,station_member_budget=0;
+
+bool StationReference(const Il2CppType* type) {
+  if(!type || type->byref)return false;
+  return type->type==IL2CPP_TYPE_CLASS || type->type==IL2CPP_TYPE_OBJECT
+    || type->type==IL2CPP_TYPE_STRING || type->type==IL2CPP_TYPE_GENERICINST
+    || type->type==IL2CPP_TYPE_ARRAY || type->type==IL2CPP_TYPE_SZARRAY;
+}
+bool StationReadable(const Il2CppType* type) {
+  if(!type || type->byref)return false;
+  if(StationReference(type))return true;
+  switch(type->type) {
+    case IL2CPP_TYPE_BOOLEAN: case IL2CPP_TYPE_I4: case IL2CPP_TYPE_U4:
+    case IL2CPP_TYPE_I8: case IL2CPP_TYPE_U8: case IL2CPP_TYPE_R4:
+    case IL2CPP_TYPE_R8: case IL2CPP_TYPE_VALUETYPE:return true;
+    default:return false;
+  }
+}
+Il2CppObject* StationMember(Il2CppObject* object,const char* name) {
+  if(!object || ++station_member_budget>512)return nullptr;
+  auto* cls=il2cpp_object_get_class(object);
+  if(const auto* property=il2cpp_class_get_property_from_name(cls,name)) {
+    const auto* getter=il2cpp_property_get_get_method(const_cast<PropertyInfo*>(property));
+    const auto* type=getter?il2cpp_method_get_return_type(getter):nullptr;
+    if(getter && !getter->parameters_count && !(getter->flags&METHOD_ATTRIBUTE_STATIC)
+       && StationReadable(type)) {
+      Il2CppException* exception=nullptr;
+      auto* result=il2cpp_runtime_invoke(getter,il2cpp_class_is_valuetype(cls)?il2cpp_object_unbox(object):object,nullptr,&exception);
+      return exception?nullptr:result;
+    }
+  }
+  auto* field=il2cpp_class_get_field_from_name(cls,name);
+  if(!field || (il2cpp_field_get_flags(field)&FIELD_ATTRIBUTE_STATIC))return nullptr;
+  const auto* type=il2cpp_field_get_type(field);
+  if(!StationReadable(type))return nullptr;
+  // The runtime boxes value fields and copies reference fields; no guessed offsets.
+  return il2cpp_field_get_value_object(field,object);
+}
+std::string StationType(Il2CppObject* object) {
+  if(!object)return "unavailable";
+  auto* cls=il2cpp_object_get_class(object);
+  return std::string(il2cpp_class_get_namespace(cls))+"."+il2cpp_class_get_name(cls);
+}
+Json StationPrimitive(Il2CppObject* object) {
+  if(!object)return nullptr;
+  auto* cls=il2cpp_object_get_class(object);
+  const auto* type=il2cpp_class_get_type(cls);
+  if(type->type==IL2CPP_TYPE_STRING) {
+    auto* string=reinterpret_cast<Il2CppString*>(object);
+    return string->length>=0 && string->length<=160?Json(to_string(string)):Json(nullptr);
+  }
+  if(il2cpp_class_is_enum(cls))type=il2cpp_class_enum_basetype(cls);
+  if(!type)return nullptr;
+  if(!il2cpp_class_is_valuetype(cls))return nullptr;
+  const auto* value=il2cpp_object_unbox(object);
+  if(!value)return nullptr;
+  switch(type->type) {
+    case IL2CPP_TYPE_BOOLEAN:return *static_cast<const bool*>(value);
+    case IL2CPP_TYPE_I4:return *static_cast<const int32_t*>(value);
+    case IL2CPP_TYPE_U4:return *static_cast<const uint32_t*>(value);
+    // IDs stay exact through JSON/JavaScript consumers.
+    case IL2CPP_TYPE_I8:return std::to_string(*static_cast<const int64_t*>(value));
+    case IL2CPP_TYPE_U8:return std::to_string(*static_cast<const uint64_t*>(value));
+    case IL2CPP_TYPE_R4:{auto v=*static_cast<const float*>(value);return std::isfinite(v)?Json(v):Json(nullptr);}
+    case IL2CPP_TYPE_R8:{auto v=*static_cast<const double*>(value);return std::isfinite(v)?Json(v):Json(nullptr);}
+    default:return nullptr;
+  }
+}
+void StationDescribe(Il2CppObject* object,uint64_t now) {
+  if(!object)return;
+  auto* cls=il2cpp_object_get_class(object);
+  if(station_described.contains(cls) || station_described.size()>=24)return;
+  station_described.insert(cls);
+  Json fields=Json::array(),properties=Json::array();
+  int depth=0;
+  for(auto* parent=cls;parent && depth<6;parent=il2cpp_class_get_parent(parent),++depth) {
+    void* iterator=nullptr;
+    while(auto* field=il2cpp_class_get_fields(parent,&iterator)) {
+      if(fields.size()>=96)break;
+      const auto* type=il2cpp_field_get_type(field);auto* field_class=type?il2cpp_class_from_type(type):nullptr;
+      fields.push_back({{"name",il2cpp_field_get_name(field)},
+        {"type",field_class?std::string(il2cpp_class_get_namespace(field_class))+"."+il2cpp_class_get_name(field_class):"unknown"},
+        {"static",(il2cpp_field_get_flags(field)&FIELD_ATTRIBUTE_STATIC)!=0}});
+    }
+    iterator=nullptr;
+    while(const auto* property=il2cpp_class_get_properties(parent,&iterator)) {
+      if(properties.size()>=96)break;
+      properties.push_back(il2cpp_property_get_name(const_cast<PropertyInfo*>(property)));
+    }
+  }
+  DiagnosticEvent("station_reader_inventory",now,{{"type",StationType(object)},{"fields",fields},{"properties",properties},
+    {"note","metadata names only; presence does not establish semantics or availability"}});
+}
+// Bounded whitelist: identity, location and native eligibility values only.
+// No enumeration of inventory, messages, services or arbitrary getters.
+Json StationModel(Il2CppObject* object,uint64_t now,int depth=0) {
+  if(!object)return nullptr;
+  if(++station_model_budget>48)return {{"status","snapshot_node_budget"}};
+  const auto primitive=StationPrimitive(object);
+  if(!primitive.is_null())return primitive;
+  StationDescribe(object,now);
+  Json values=Json::object();
+  for(const char* name:{"ID","Id","StationId","OutpostId","UserId","PlayerId","TargetId","SystemId","SystemID",
+      "NodeId","Index","CurrentState","PreviousState","IsLocalPlayer","IsOwnStation","IsDestroyed",
+      "IsShielded","HasShield","CanAttack","CanEngage","IsValid","IsTargetLost","TargetType",
+      "x","y","z","X","Y","Z"}) {
+    auto value=StationPrimitive(StationMember(object,name));
+    if(!value.is_null())values[name]=std::move(value);
+  }
+  if(depth<2) {
+    for(const char* name:{"TargetStationData","TargetStation","TargetOutpostData","TargetOutpost",
+        "StationData","OutpostData","TargetData","Target","TargetUser","TargetPlayer","TargetProfile",
+        "Address","TargetAddress","NodeAddress","SystemPosition","Position","SelectedFleetPlayerData",
+        "SelectedPlayerFleet","SelectedFleet","PlayerFleetData"}) {
+      auto* child=StationMember(object,name);
+      if(child && child!=object)values[name]=StationModel(child,now,depth+1);
+    }
+    // Field-only fallback discovers actual station-target member spellings. It
+    // does not execute unlisted getters. Restrict to semantic reference fields.
+    auto* cls=il2cpp_object_get_class(object);int level=0,reads=0;
+    for(auto* parent=cls;parent && level<4;parent=il2cpp_class_get_parent(parent),++level) {
+      void* iterator=nullptr;
+      while(auto* field=il2cpp_class_get_fields(parent,&iterator)) {
+        if(++reads>64)break;
+        const std::string name=il2cpp_field_get_name(field);
+        auto lower=name;std::transform(lower.begin(),lower.end(),lower.begin(),[](unsigned char c){return static_cast<char>(std::tolower(c));});
+        const bool relevant=lower.find("station")!=std::string::npos || lower.find("outpost")!=std::string::npos
+          || lower.find("address")!=std::string::npos || lower.find("target")!=std::string::npos;
+        if(!relevant || (il2cpp_field_get_flags(field)&FIELD_ATTRIBUTE_STATIC)
+           || !StationReference(il2cpp_field_get_type(field)))continue;
+        auto* child=il2cpp_field_get_value_object(field,object);
+        if(child && child!=object)values["field:"+name]=StationModel(child,now,depth+1);
+      }
+      if(reads>64)break;
+    }
+  }
+  return {{"type",StationType(object)},{"values",values}};
+}
+Json StationCard(Il2CppObject* viewer,Il2CppObject* buttons,uint64_t now) {
+  auto* battle=StationMember(buttons,"Context");
+  if(!battle)battle=StationMember(viewer,"_battleTargetData");
+  auto* ui=StationMember(viewer,"Context");
+  auto* engage=StationMember(buttons,"_engageButton");
+  StationDescribe(viewer,now);StationDescribe(buttons,now);
+  return {{"viewer_type",StationType(viewer)},{"buttons_type",StationType(buttons)},
+    {"selected_fleet_id",std::to_string(observed_selected_fleet)},
+    {"battle_target",StationModel(battle,now)},{"navigation_context",StationModel(ui,now)},
+    {"engage_interactable",DiagnosticBool(engage,"interactable")},
+    {"engage_enabled",DiagnosticBool(engage,"isActiveAndEnabled")},
+    {"mode","read_only"},{"target_identity_status","raw_named_members_not_yet_live_validated"}};
+}
+// Existing ObjectTracker registers PreScanTargetWidget subclasses recursively.
+// Match the concrete station class, never infer 'station' from a nearby fleet.
+Json StationVisibleCards(uint64_t now,Il2CppObject* required_buttons=nullptr) {
+  station_model_budget=0;station_member_budget=0;
+  Json cards=Json::array();int checked=0;
+  for(auto* candidate:ObjectFinder<PreScanTargetWidget>::GetAll()) {
+    if(++checked>32)break;
+    auto* viewer=reinterpret_cast<Il2CppObject*>(candidate);
+    if(!viewer)continue;
+    auto* station_class=il2cpp_get_class_helper("Assembly-CSharp","Digit.Prime.Combat","PreScanStationTargetWidget").get_cls();
+    if(!station_class || !il2cpp_class_is_assignable_from(station_class,il2cpp_object_get_class(viewer)))continue;
+    auto* buttons=StationMember(viewer,"_scanEngageButtonsWidget");
+    if(required_buttons && buttons!=required_buttons)continue;
+    const auto active=DiagnosticBool(viewer,"isActiveAndEnabled");
+    auto* visibility=StationMember(viewer,"_visibilityController");
+    auto state=Scalar(visibility,"VisibilityState");
+    if(state.is_null())state=StationPrimitive(StationMember(visibility,"_state"));
+    // Unknown visibility is explicitly unavailable, not an active selection.
+    if(active!=Json(true) || !(state==Json(1) || state==Json(4)))continue;
+    cards.push_back(StationCard(viewer,buttons,now));
+  }
+  return cards;
+}
+void StationEngageHook(auto original,Il2CppObject* buttons) {
+  // Observe manual/native action entry only. The original is always called once.
+  diagnostics::ObserveAndForward([&] {
+    const auto now=GetTickCount64();auto cards=StationVisibleCards(now,buttons);
+    if(!cards.empty())DiagnosticEvent("station_engage_handler_entered",now,{{"cards",cards},
+      {"meaning","native handler entered; not server acceptance or combat success"}});
+  },[&] {original(buttons);});
+}
+void StartStationDiagnostics() {
+  auto* cls=il2cpp_get_class_helper("Assembly-CSharp","Digit.Prime.Combat","ScanEngageButtonsWidget").get_cls();
+  const auto* method=cls?il2cpp_class_get_method_from_name(cls,"OnEngageButtonClicked",0):nullptr;
+  const auto* result=method?il2cpp_method_get_return_type(method):nullptr;
+  const bool signature=method && !method->parameters_count && !(method->flags&METHOD_ATTRIBUTE_STATIC)
+    && !method->is_generic && !method->is_inflated && !method->has_full_generic_sharing_signature
+    && result && !result->byref && result->type==IL2CPP_TYPE_VOID && method->methodPointer;
+  bool installed=false;
+  if(signature)installed=SPUD_STATIC_DETOUR(method->methodPointer,StationEngageHook);
+  DiagnosticEvent("station_monitor_started",GetTickCount64(),{{"engage_observer_installed",installed},
+    {"selection_poll_ms",200},{"mode","read_only"},{"actions_issued",false}});
+}
+void PollStationDiagnostics(uint64_t now) {
+  auto cards=StationVisibleCards(now);const auto key=cards.dump();
+  if(key!=station_snapshot_key || (now>=station_heartbeat && now-station_heartbeat>=10000)) {
+    const bool changed=key!=station_snapshot_key;
+    station_snapshot_key=key;station_heartbeat=now;
+    DiagnosticEvent(changed?"station_selection_changed":"station_selection_heartbeat",now,{{"cards",cards},
+      {"previous_card_observed",!station_last_snapshot.is_null()},
+      {"freshness","visible_client_context_server_age_unverified"}});
+    station_last_snapshot=cards.empty()?Json(nullptr):cards;
+  }
+}
