+// Included inside hostile_audit, after its anonymous helper namespace.
+namespace {
+struct OwnTactics {
+ tactical::Motion motion;std::optional<double> speed;int64_t speed_at=0,last_seen=0,last_log=0;
+ std::string hull; tactical::QueueLatch queue;int64_t queue_at=-1000;
+ std::optional<int> count;bool disabled=false;std::string queue_source;
+ int64_t dispatched_at=0,target=0;std::optional<double> predicted;bool validating=false;
+};
+std::unordered_map<uint64_t,OwnTactics> tactical_own;
+std::unordered_map<int64_t,tactical::Motion> tactical_motion;
+std::unordered_map<int64_t,int64_t> tactical_seen;
+Json TacticalCall(Il2CppObject* manager,const char* name,FleetPlayerData* fleet=nullptr) {
+ if(!manager)return nullptr;
+ const auto* method=il2cpp_class_get_method_from_name(il2cpp_object_get_class(manager),name,fleet?1:0);
+ const auto* type=method?il2cpp_method_get_return_type(method):nullptr;
+ if(!method || (method->flags&METHOD_ATTRIBUTE_STATIC) || !type || type->byref
+    || (type->type!=IL2CPP_TYPE_BOOLEAN && type->type!=IL2CPP_TYPE_I4))return nullptr;
+ if(fleet) {
+  const auto* p=il2cpp_method_get_param(method,0);
+  if(!p || p->byref || il2cpp_class_from_type(p)!=il2cpp_object_get_class(Object(fleet)))return nullptr;
+ }
+ void* args[]={fleet};Il2CppException* error=nullptr;
+ auto* result=il2cpp_runtime_invoke(method,manager,fleet?args:nullptr,&error);
+ const auto* value=!error&&result?il2cpp_object_unbox(result):nullptr;
+ if(!value)return nullptr;
+ return type->type==IL2CPP_TYPE_BOOLEAN?Json(*static_cast<const bool*>(value)):Json(*static_cast<const int32_t*>(value));
+}
+struct TacticalQueueType {
+ static IL2CppClassHelper& get_class_helper() {
+  static auto helper=il2cpp_get_class_helper("Assembly-CSharp","Prime.ActionQueue","ActionQueueManager");return helper;
+ }
+};
+Il2CppObject* TacticalQueueManager() {
+ if(auto* tracked=ObjectFinder<TacticalQueueType>::Get())return reinterpret_cast<Il2CppObject*>(tracked);
+ auto* expected=il2cpp_get_class_helper("Assembly-CSharp","Prime.ActionQueue","ActionQueueManager").get_cls();
+ int depth=0;
+ for(auto* cls=expected;cls && depth<12;cls=il2cpp_class_get_parent(cls),++depth) {
+  const auto* p=il2cpp_class_get_property_from_name(cls,"Instance");
+  const auto* method=p?il2cpp_property_get_get_method(const_cast<PropertyInfo*>(p)):nullptr;
+  const auto* type=method?il2cpp_method_get_return_type(method):nullptr;
+  if(!method)continue;
+  if(method->parameters_count || !(method->flags&METHOD_ATTRIBUTE_STATIC) || !type || type->byref
+    || (type->type!=IL2CPP_TYPE_CLASS && type->type!=IL2CPP_TYPE_OBJECT && type->type!=IL2CPP_TYPE_GENERICINST && type->type!=IL2CPP_TYPE_VAR))return nullptr;
+  Il2CppException* error=nullptr;auto* value=il2cpp_runtime_invoke(method,nullptr,nullptr,&error);
+  return !error && value && il2cpp_class_is_assignable_from(expected,il2cpp_object_get_class(value))?value:nullptr;
+ }
+ return nullptr;
+}
+bool TacticalCombat(FleetPlayerData* own) {
+ return own && (own->CurrentState==FleetState::Battling
+   || Scalar(Object(VisibleHostileModel(static_cast<int64_t>(own->Id))),"CurrentlyBattling")==Json(true));
+}
+tactical::Vec TacticalVec(Position p){return {p.x,p.y,p.z};}
+bool TacticalElite(int64_t target) {
+ CaptureIdentity(VisibleHostileModel(target));const auto it=identities.find(target);
+ if(it==identities.end())return false;
+ const auto ref=it->second.value("ref_id",Json(nullptr));
+ const auto hull=it->second.value("hull_id_string",Json(nullptr));
+ return tactical::Elite(ref.is_string()?ref.get<std::string>():ref.is_number()?ref.dump():"",
+   hull.is_string()?hull.get<std::string>():"",it->second.value("is_elite",Json(nullptr))==Json(true));
+}
+tactical::Score TacticalScore(int64_t id,uint64_t own,double distance2) {
+ tactical::Score score{id,distance2,TacticalElite(id),false,{}};
+ const auto os=tactical_own.find(own);const auto ts=tactical_motion.find(id);const auto now=Now();
+ Position a,b;
+ if(os==tactical_own.end() || ts==tactical_motion.end() || !os->second.speed || now-os->second.speed_at>30000
+   || !PositionOf(static_cast<int64_t>(own),a) || !PositionOf(id,b))return score;
+ const auto velocity=ts->second.Velocity(now);if(!velocity)return score;
+ score.trajectory_known=true;score.eta=tactical::Intercept(tactical::Sub(TacticalVec(b),TacticalVec(a)),*velocity,*os->second.speed);
+ return score;
+}
+}
+void TacticalSample(FleetPlayerData* own) {
+ if(!own || !own->Id)return;
+ const auto now=Now();
+ for(auto it=tactical_own.begin();it!=tactical_own.end();) {
+  if(now-it->second.last_seen>300000)it=tactical_own.erase(it);else ++it;
+ }
+ if(!tactical_own.contains(own->Id) && tactical_own.size()>=16)return;
+ auto& os=tactical_own[own->Id];os.last_seen=now;
+ const auto hull=Scalar(Object(own),"HullId").dump();
+ if(hull!=os.hull){os={};os.hull=hull;os.last_seen=now;}
+ Position p;
+ if(own->CurrentState==FleetState::Impulsing && PositionOf(static_cast<int64_t>(own->Id),p)) {
+  os.motion.Add(now,TacticalVec(p));
+  if(own->CurrentState==FleetState::Impulsing)if(const auto v=os.motion.Velocity(now)) {
+   const auto speed=tactical::Norm(*v);
+   if(speed>0.01 && std::isfinite(speed)){os.speed=speed;os.speed_at=now;}
+  }
+ }else os.motion={};
+ for(auto it=tactical_seen.begin();it!=tactical_seen.end();) {
+  if(now-it->second>5000){tactical_motion.erase(it->first);it=tactical_seen.erase(it);}else ++it;
+ }
+ int count=0;
+ for(const auto id:VisibleRegularHostileIds()) {
+  if(++count>512)break;
+  Position target;if(!PositionOf(id,target))continue;
+  if(!tactical_seen.contains(id) && tactical_seen.size()>=2048)continue;
+  tactical_seen[id]=now;tactical_motion[id].Add(now,TacticalVec(target));
+ }
+ if(os.validating && (TacticalCombat(own) || now-os.dispatched_at>60000)) {
+  Position target;const bool target_seen=PositionOf(os.target,target);
+  Write({{"event","intercept_observation"},{"own_id",std::to_string(own->Id)},
+   {"target_id",std::to_string(os.target)},{"elapsed_seconds",(now-os.dispatched_at)/1000.},
+   {"predicted_seconds",os.predicted?Json(*os.predicted):Json(nullptr)},
+   {"own_combat_observed",TacticalCombat(own)},
+   {"target_distance2_at_observation",target_seen&&PositionOf(static_cast<int64_t>(own->Id),p)?Json(Distance2(p,target)):Json(nullptr)},
+   {"validation","own_combat_entry_after_dispatch; opposing_target_unverified; not_a_paired_hit_confirmation"}});
+  os.validating=false;
+ }
+}
+bool TacticalBusy(FleetPlayerData* own,std::string& reason,bool force) {
+ if(!own){reason="ship_unavailable";return true;}
+ if(!tactical_own.contains(own->Id) && tactical_own.size()>=16){reason="ship_state_capacity";return true;}
+ auto& os=tactical_own[own->Id];const auto now=Now();os.last_seen=now;
+ if(force || now-os.queue_at>=100) {
+  os.queue_at=now;auto* manager=TacticalQueueManager();
+  const auto count=TacticalCall(manager,"GetActionQueueCount",own);
+  os.count=count.is_number_integer()&&count.get<int>()>=0?std::optional<int>(count.get<int>()):std::nullopt;
+  os.disabled=TacticalCall(manager,"get_IsQueueEnabled")==Json(false) || TacticalCall(manager,"IsQueueUnlocked")==Json(false);
+  os.queue_source=manager?"ActionQueueManager.GetActionQueueCount":"queue_manager_unavailable";
+ }
+ const auto combat=TacticalCombat(own);
+ const auto busy=os.queue.Busy(now,combat,own->CurrentState==FleetState::IdleInSpace,os.count,os.disabled);
+ reason=combat?"combat_in_progress":os.count && *os.count>0?"manual_queue_pending":!os.count&&!os.disabled?"queue_state_unavailable":busy?"waiting_for_queued_actions_to_finish":"ready";
+ if(busy && now-os.last_log>=1000) {
+  os.last_log=now;
+  Write({{"event","selection_paused"},{"own_id",std::to_string(own->Id)},{"reason",reason},
+   {"queued_count",os.count?Json(*os.count):Json(nullptr)},{"source",os.queue_source},
+   {"own_state",static_cast<int>(own->CurrentState)},{"target_failure_recorded",false}});
+ }
+ return busy;
+}
+int64_t TacticalChoose(const std::vector<RankedTarget>& candidates,int64_t current,double distance2,uint64_t own) {
+ std::vector<tactical::Score> scores;scores.reserve(candidates.size()+1);
+ for(const auto& c:candidates)scores.push_back(TacticalScore(c.id,own,c.distance2));
+ if(current && distance2>=0)scores.push_back(TacticalScore(current,own,distance2));
+ const auto choice=tactical::Choose(scores,current);
+
+ const auto now=Now();
+ if(now-tactical_own[own].last_log>=1000 || choice.id!=current) {
+  tactical_own[own].last_log=now;Json rows=Json::array();
+  std::sort(scores.begin(),scores.end(),[&](const auto& a,const auto& b){
+   if(a.elite!=b.elite)return a.elite>b.elite;
+   if(choice.intercept_mode && a.eta!=b.eta)return a.eta.value_or(std::numeric_limits<double>::infinity())<b.eta.value_or(std::numeric_limits<double>::infinity());
+   return a.distance2<b.distance2;
+  });
+  for(const auto& s:scores){if(rows.size()>=8)break;rows.push_back({{"target_id",std::to_string(s.id)},
+   {"elite",s.elite},{"distance2",s.distance2},{"trajectory_known",s.trajectory_known},
+   {"predicted_seconds",s.eta?Json(*s.eta):Json(nullptr)}});}
+  const auto os=tactical_own.find(own);
+  Write({{"event","tactical_ranking"},{"own_id",std::to_string(own)},{"target_id",std::to_string(choice.id)},
+   {"incumbent",std::to_string(current)},{"mode",choice.intercept_mode?"intercept_estimate":"nearest_fallback"},
+   {"elite_priority",true},{"own_speed",os!=tactical_own.end()&&os->second.speed?Json(*os->second.speed):Json(nullptr)},
+   {"own_speed_age_ms",os!=tactical_own.end()&&os->second.speed?Json(now-os->second.speed_at):Json(nullptr)},
+   {"speed_source","observed_impulse_model_motion; no_warp_samples"},{"candidates",rows},
+   {"prediction_horizon_seconds",30},{"native_game_handles_pursuit",true}});
+ }
+ return choice.id;
+}
+void TacticalDispatched(int64_t target,FleetPlayerData* own) {
+ if(!own)return;auto& os=tactical_own[own->Id];
+ Position a,b;const auto distance=PositionOf(static_cast<int64_t>(own->Id),a)&&PositionOf(target,b)?Distance2(a,b):-1;
+ const auto score=TacticalScore(target,own->Id,distance);
+ os.target=target;os.predicted=score.eta;os.dispatched_at=Now();os.validating=true;
+ Write({{"event","intercept_prediction"},{"own_id",std::to_string(own->Id)},{"target_id",std::to_string(target)},
+  {"elite",score.elite},{"predicted_seconds",score.eta?Json(*score.eta):Json(nullptr)},
+  {"distance2",distance},{"prediction_only",true},{"native_game_handles_pursuit",true}});
+}
diff --git a/mods/src/toml_editor.cc b/mods/src/toml_editor.cc
new file mode 100644
index 0000000..b142d77
--- /dev/null
+++ b/mods/src/toml_editor.cc
@@ -0,0 +1,179 @@
+#include "toml_editor.h"
+#include "config_save.h"
+
+#include <cmath>
+#include <sstream>
+#include <stdexcept>
+
+namespace config_edit
+{
+namespace
+{
+  std::string Encode(const Value& value)
+  {
+    return std::visit(
+        [](const auto& item) {
+          const toml::value  node(item);
+          std::ostringstream output;
+          output.exceptions(std::ios::badbit | std::ios::failbit);
+          output << toml::toml_formatter(node, toml::format_flags::none);
+          return output.str();
+        },
+        value);
+  }
+
+  std::optional<Value> ReadValue(const toml::node* node)
+  {
+    if (!node)
+      return std::nullopt;
+    if (node->is_boolean())
+      return Value{node->as_boolean()->get()};
+    if (node->is_string())
+      return Value{node->as_string()->get()};
+    if (node->is_floating_point())
+      return Value{node->as_floating_point()->get()};
+    if (node->is_integer())
+      return Value{node->as_integer()->get()};
+    throw std::invalid_argument("unsupported setting type");
+  }
+
+  std::size_t BomSize(std::string_view text)
+  { return text.starts_with("\xef\xbb\xbf") ? 3 : 0; }
+
+  // toml++ columns count Unicode codepoints, including CR; only LF starts a line.
+  std::size_t Offset(std::string_view text, toml::source_position target)
+  {
+    toml::source_position current{1, 1};
+    for (auto i = BomSize(text);;) {
+      if (current == target)
+        return i;
+      if (i >= text.size())
+        throw std::invalid_argument("invalid source region");
+      const auto byte = static_cast<unsigned char>(text[i]);
+      if (byte == '\n') {
+        ++current.line;
+        current.column = 1;
+      } else
+        ++current.column;
+      ++i;
+      // Input has already passed TOML/UTF-8 validation.
+      while (i < text.size() && (static_cast<unsigned char>(text[i]) & 0xc0) == 0x80)
+        ++i;
+    }
+  }
+} // namespace
+
+Prepared TomlEditor::Prepare(const std::string& text, const Request& request)
+{
+  try {
+    if (const auto* value = std::get_if<double>(&request.desired); value && !std::isfinite(*value))
+      return {Outcome::Unsupported, {}};
+    if (!cached_table_ || cached_text_ != text) {
+      auto parsed = toml::parse(text);
+      cached_table_.reset(); // Never pair new bytes with stale regions if allocation fails.
+      cached_text_  = text;
+      cached_table_ = std::move(parsed);
+    }
+    const auto& document = *cached_table_;
+    const auto* parent   = document.get_as<toml::table>(request.section);
+    if (document.contains(request.section) && !parent)
+      return {Outcome::Unsupported, {}};
+    const auto* node    = parent ? parent->get(request.key) : nullptr;
+    const auto  current = ReadValue(node);
+    if (current && *current == request.desired)
+      return {Outcome::AlreadySaved, {}};
+    if (current != request.expected)
+      return {Outcome::Conflict, {}};
+
+    auto desired_document = document;
+    if (!parent)
+      desired_document.insert(request.section, toml::table{});
+    std::visit(
+        [&](const auto& value) {
+          desired_document.get_as<toml::table>(request.section)->insert_or_assign(request.key, value);
+        },
+        request.desired);
+
+    // Accept a candidate only if a fresh parse has exactly the intended meaning.
+    auto accepts = [&](const std::string& candidate) {
+      try {
+        return toml::parse(candidate) == desired_document;
+      } catch (const toml::parse_error&) {
+        return false;
+      }
+    };
+    const auto encoded = Encode(request.desired);
+    if (node) {
+      const auto begin = Offset(text, node->source().begin);
+      const auto end   = Offset(text, node->source().end);
+      if (end < begin || end > text.size())
+        return {Outcome::Unsupported, {}};
+      auto result = text;
+      result.replace(begin, end - begin, encoded);
+      if (accepts(result))
+        return {Outcome::Prepared, std::move(result)};
+      return {Outcome::Unsupported, {}};
+    }
+
+    const auto newline    = text.find("\r\n") != std::string::npos ? "\r\n" : "\n";
+    const auto assignment = Encode(Value{request.key}) + " = " + encoded;
+    if (parent && parent->is_inline()) {
+      const auto end = Offset(text, parent->source().end);
+      if (!end || text[end - 1] != '}')
+        return {Outcome::Unsupported, {}};
+      auto result = text;
+      result.insert(end - 1, (parent->empty() ? " " : ", ") + assignment + " ");
+      if (accepts(result))
+        return {Outcome::Prepared, std::move(result)};
+      return {Outcome::Unsupported, {}};
+    }
+    if (parent) {
+      const auto begin = Offset(text, parent->source().begin);
+      if (begin < text.size() && text[begin] == '[') {
+        auto end    = text.find('\n', begin);
+        auto result = text;
+        if (end == std::string::npos)
+          result += std::string(newline) + assignment + newline;
+        else
+          result.insert(end + 1, assignment + newline);
+        if (accepts(result))
+          return {Outcome::Prepared, std::move(result)};
+      }
+      // Dotted/implicit tables can sometimes be extended at the document root.
+      auto result = text;
+      result.insert(BomSize(text), Encode(Value{request.section}) + "." + assignment + newline);
+      if (accepts(result))
+        return {Outcome::Prepared, std::move(result)};
+    }
+    auto result = text;
+    if (!result.empty() && result.back() != '\n')
+      result += newline;
+    result += "[" + Encode(Value{request.section}) + "]" + newline + assignment + newline;
+    if (accepts(result))
+      return {Outcome::Prepared, std::move(result)};
+    return {Outcome::Unsupported, {}};
+  } catch (const toml::parse_error&) {
+    return {Outcome::InvalidDocument, {}};
+  } catch (const std::invalid_argument&) {
+    return {Outcome::Unsupported, {}};
+  }
+}
+
+Outcome TomlEditor::Save(const std::filesystem::path& path, const Request& request)
+{
+  try {
+    const auto original = ReadConfigText(path);
+    auto       edit     = Prepare(original, request);
+    if (edit.outcome != Outcome::Prepared)
+      return edit.outcome;
+    if (!ReplaceConfigText(path, edit.text, original))
+      return Outcome::Conflict;
+    // Source locations belong to the old document; refresh on the next request.
+    cached_table_.reset();
+    cached_text_.clear();
+    return Outcome::Saved;
+  } catch (const std::exception&) {
+    return Outcome::IoError;
+  }
+}
+} // namespace config_edit
diff --git a/mods/src/toml_editor.h b/mods/src/toml_editor.h
