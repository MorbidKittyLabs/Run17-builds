+#pragma once
+#include <utility>
+namespace fleet_diagnostics::diagnostics {
+// Telemetry must not cancel, duplicate or retry a native player action.
+template<class Observe,class Forward>
+void ObserveAndForward(Observe&& observe,Forward&& forward) {
+  try {std::forward<Observe>(observe)();}catch(...){}
+  std::forward<Forward>(forward)();
+}
+}
