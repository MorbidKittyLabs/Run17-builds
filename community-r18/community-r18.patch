+bool ManualInputReady() noexcept {return !published || (published->visible==1 && published->section==static_cast<int>(SectionID::Navigation_System));}
+void Pump() noexcept {
+ try {
+  if(!published)return;
+  const auto now=GetTickCount64();if(now-last_poll<50)return;last_poll=now;
+  auto* sections=Hub::get_SectionManager();
+  const auto section=sections?sections->CurrentSection:SectionID{};
+  const bool view=sections && (section==SectionID::Navigation_System || section==SectionID::Navigation_Galaxy
+    || section==SectionID::Starbase_Exterior || section==SectionID::Starbase_Interior);
+  auto* hud=hud_handle?il2cpp_gchandle_get_target(hud_handle):nullptr;
+  auto* game_object=Reference(hud,"gameObject");
