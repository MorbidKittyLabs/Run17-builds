new file mode 100644
index 0000000..7186a1b
--- /dev/null
+++ b/mods/src/patches/parts/hostile_target_policy.h
@@ -0,0 +1,251 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <limits>
+#include <utility>
+#include <vector>
+
+namespace hostile_audit {
+enum class Motion { Unknown, Moving, Stationary };
+enum class Attack { Unknown, Usable, Disabled };
+struct Position { double x = 0, y = 0, z = 0; };
+inline double Distance2(Position a, Position b)
+{
+  const auto x = a.x - b.x, y = a.y - b.y, z = a.z - b.z;
+  return x * x + y * y + z * z;
+}
+
+// Positions from FleetDeployedData.SystemPosition, independent of the camera.
+// A gap invalidates the window. F6 requires separate, current positive motion
+// evidence; the long observation window is diagnostic and never grants permission.
+class MotionWindow {
+  struct Sample { int64_t time; Position position; };
+  std::deque<Sample> samples;
+public:
+  static constexpr int64_t WindowMs = 10000;
+  static constexpr int64_t MotionProofMaxAgeMs = 300;
+  static constexpr int64_t MotionProofMinSpanMs = 500;
+  static constexpr int64_t MotionProofMaxStepMs = 1500;
+  static constexpr int64_t StationaryProofMinSpanMs = 1500;
+  static constexpr double MotionStep2 = 0.000000000001; // 0.000001 world units
+  static constexpr double Movement2 = 0.000001; // 0.001 world units; logged for calibration
+  void Clear() { samples.clear(); }
+  Motion Add(int64_t now, Position position)
+  {
+    if (!std::isfinite(position.x) || !std::isfinite(position.y) || !std::isfinite(position.z)) {
+      Clear();
+      return Motion::Unknown;
+    }
+    if (!samples.empty() && (now <= samples.back().time || now - samples.back().time > 1500)) Clear();
+    samples.push_back({now, position});
+    while (samples.size() > 1 && now - samples[1].time >= WindowMs) samples.pop_front();
+    return State();
+  }
+  int64_t Span() const { return samples.empty() ? 0 : samples.back().time - samples.front().time; }
+  double Displacement2() const
+  {
+    double maximum = 0;
+    if (!samples.empty()) for (const auto& sample : samples)
+      if (const auto distance = Distance2(samples.front().position, sample.position); distance > maximum)
+        maximum = distance;
+    return maximum;
+  }
+  // Require two successive, coherent position changes. A single unchanged
+  // sample revokes permission even if the diagnostic 10-second window still
+  // contains earlier travel. Unknown/stale/missing motion never grants F6.
+  bool RecentlyMoving(int64_t now) const
+  {
+    if (samples.size() < 3 || now < samples.back().time
+        || now - samples.back().time > MotionProofMaxAgeMs) return false;
+    const auto& a = samples[samples.size() - 3];
+    const auto& b = samples[samples.size() - 2];
+    const auto& c = samples.back();
+    if (c.time - a.time < MotionProofMinSpanMs || b.time - a.time > MotionProofMaxStepMs
+        || c.time - b.time > MotionProofMaxStepMs
+        || Distance2(a.position, b.position) <= MotionStep2
+        || Distance2(b.position, c.position) <= MotionStep2) return false;
+    const auto dot = (b.position.x - a.position.x) * (c.position.x - b.position.x)
+                     + (b.position.y - a.position.y) * (c.position.y - b.position.y)
+                     + (b.position.z - a.position.z) * (c.position.z - b.position.z);
+    return dot > 0;
+  }
+  Motion Current(int64_t now) const
+  {
+    if (samples.size() < 2 || now < samples.back().time
+        || now - samples.back().time > MotionProofMaxAgeMs) return Motion::Unknown;
+    if (LatestStep2() <= MotionStep2) {
+      // A repeated network/model sample is not proof that a ship has parked.
+      // Do not authorize an attack during this uncertainty, but distinguish it
+      // from sustained stationary evidence before abandoning a pursuit.
+      auto still_since = samples.back().time;
+      for (auto it = samples.rbegin() + 1; it != samples.rend(); ++it) {
+        if (Distance2(it->position, samples.back().position) > MotionStep2) break;
+        still_since = it->time;
+      }
+      return now - still_since >= StationaryProofMinSpanMs ? Motion::Stationary : Motion::Unknown;
+    }
+    return RecentlyMoving(now) ? Motion::Moving : Motion::Unknown;
+  }
+  double LatestStep2() const
+  {
+    return samples.size() < 2 ? 0 : Distance2(samples[samples.size()-2].position, samples.back().position);
+  }
+  Motion State() const
+  {
+    if (Displacement2() > Movement2) return Motion::Moving;
+    return Span() >= WindowMs ? Motion::Stationary : Motion::Unknown;
+  }
+};
+
+enum class ProbeStatus { MissingPanel, UnknownButton, DisabledButton, UnknownMotion, Stationary, Invalid, Ready };
+enum class EngageDecision { Wait, Dispatch, Reject, Timeout, Stale };
+
+// UI observations must be evaluated before the normal deadline. A separate
+// hard age limit prevents an old request firing after a long client suspension.
+class EngageWindow {
+  int64_t selected_at = 0, next_probe = 0;
+public:
+  static constexpr int64_t WaitMs = 3000, MaxAgeMs = 6000, ProbeEveryMs = 125;
+  void Begin(int64_t now) { selected_at = next_probe = now; }
+  int64_t AgeMs(int64_t now) const { return now-selected_at; }
+  bool Stale(int64_t now) const { return now < selected_at || now - selected_at > MaxAgeMs; }
+  bool Due(int64_t now)
+  {
+    if (now < next_probe) return false;
+    next_probe = now + ProbeEveryMs;
+    return true;
+  }
+  EngageDecision Decide(int64_t now, ProbeStatus status) const
+  {
+    if (Stale(now)) return EngageDecision::Stale;
+    if (status == ProbeStatus::Ready) return EngageDecision::Dispatch;
+    if (status == ProbeStatus::Stationary || status == ProbeStatus::Invalid) return EngageDecision::Reject;
+    if (status == ProbeStatus::UnknownMotion) return EngageDecision::Wait;
+    return now - selected_at >= WaitMs ? EngageDecision::Timeout : EngageDecision::Wait;
+  }
+};
+
+struct RankedTarget { int64_t id = 0; double distance2 = 0; };
+
+// The selection survives a handler call and every macro repeat. Eligibility of
+// NEW candidates is separate from retention of an existing pursuit: unknown
+// movement must never silently remove the incumbent's distance comparison.
+class TargetPursuit {
+  int64_t target = 0, dispatched_at = 0, missing_since = 0;
+  bool dispatched = false, combat_seen = false, missing = false;
+public:
+  static constexpr int64_t RetryMs = 750, MissingGraceMs = 3000;
+  int64_t Target() const { return target; }
+  bool Dispatched() const { return dispatched; }
+  bool CombatSeen() const { return combat_seen; }
+  void Select(int64_t id) { *this = {}; target = id; }
+  void MarkDispatched(int64_t now) { dispatched = true; dispatched_at = now; }
+  void ObserveCombat() { combat_seen = true; }
+  bool RetryDue(int64_t now) const { return dispatched && now >= dispatched_at && now-dispatched_at >= RetryMs; }
+  void Seen() { missing = false; }
+  bool MissingExpired(int64_t now)
+  {
+    if (!missing || now < missing_since) { missing = true; missing_since = now; }
+    return now-missing_since >= MissingGraceMs;
+  }
+  int64_t Choose(const std::vector<RankedTarget>& candidates, double current_distance2) const
+  {
+    if (target && (!std::isfinite(current_distance2) || current_distance2 < 0)) return target;
+    auto best = target;
+    auto distance = target ? current_distance2 : std::numeric_limits<double>::infinity();
+    for (const auto& candidate : candidates) {
+      if (candidate.id <= 0 || !std::isfinite(candidate.distance2) || candidate.distance2 < 0) continue;
+      // Tiny relative tolerance prevents floating-point ties changing targets.
+      const bool nearer = candidate.distance2 < distance &&
+                          (!best || distance-candidate.distance2 > std::abs(distance)*0.000001);
+      if (nearer || (!target && candidate.distance2 == distance && (!best || candidate.id < best))) {
+        best = candidate.id;
+        distance = candidate.distance2;
+      }
+    }
+    return best;
+  }
+};
+
+class TargetCooldowns {
+  struct Entry { int64_t until=0, forget_after=0; unsigned failures=0; };
+  std::map<std::pair<uint64_t,int64_t>, Entry> entries;
+public:
+  int64_t Put(uint64_t own, int64_t target, int64_t now, int64_t duration)
+  {
+    for (auto it=entries.begin(); it!=entries.end(); )
+      if (it->second.forget_after <= now) it=entries.erase(it); else ++it;
+    auto& entry=entries[{own,target}];
+    if (entry.failures < 8) ++entry.failures;
+    auto delay=duration;
+    for (unsigned i=1; i<entry.failures && delay<300000; ++i) delay*=2;
+    if (delay>300000) delay=300000;
+    if (now+delay>entry.until) entry.until=now+delay;
+    entry.forget_after=now+600000;
+    return entry.until-now;
+  }
+  bool Contains(uint64_t own, int64_t target, int64_t now)
+  {
+    const auto it=entries.find({own,target});
+    if (it==entries.end()) return false;
+    if (now>=it->second.forget_after) { entries.erase(it); return false; }
+    return now<it->second.until;
+  }
+  void Erase(uint64_t own, int64_t target) { entries.erase({own,target}); }
+};
+
+// A handler call is not engagement confirmation. Repeated dispatches for the
+// same pursuit do not restart this timer. Only observed game state is evidence.
+class EngagementProgress {
+  bool active = false, idle_tracking = false;
+  int64_t first_dispatch = 0, idle_since = 0;
+public:
+  void Reset() { active = idle_tracking = false; }
+  void Begin(int64_t now)
+  {
+    if (!active) { active=true; first_dispatch=now; idle_tracking=false; }
+  }
+  bool Failed(int64_t now, bool own_idle, bool combat)
+  {
+    if (combat) { Reset(); return false; }
+    if (!active) return false;
+    if (!own_idle) { idle_tracking=false; return false; }
+    if (!idle_tracking) { idle_since=now; idle_tracking=true; }
+    if (now-first_dispatch < 6000 || now-idle_since < 2000) return false;
+    Reset();
+    return true;
+  }
+};
+
+// Each count is a distinct user attempt with a matching, positively disabled
+// Attack button. Frames, timeouts, missing bindings and dispatch calls do not count.
+class StallEvidence {
+  uint64_t last_attempt = 0;
+  unsigned count = 0;
+  int64_t first = 0, last = 0;
+public:
+  void Clear() { last_attempt = 0; count = 0; first = last = 0; }
+  unsigned Count() const { return count; }
+  bool Observe(uint64_t attempt, int64_t now, double distance2, Attack attack,
+               bool own_idle, bool target_idle, Motion motion, bool combat_seen)
+  {
+    if (combat_seen || attack == Attack::Usable || !own_idle || !target_idle
+        || motion == Motion::Moving || !std::isfinite(distance2) || distance2 > 0.001) {
+      Clear();
+      return false;
+    }
+    if (!attempt || attack != Attack::Disabled) return false;
+    if (last && now - last > 15000) Clear();
+    if (attempt != last_attempt) {
+      if (!count) first = now;
+      ++count;
+      last_attempt = attempt;
+      last = now;
+    }
+    return motion == Motion::Stationary && count >= 3 && now - first >= 6000;
+  }
+};
+} // namespace hostile_audit
