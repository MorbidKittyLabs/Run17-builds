diff --git a/mods/src/collective_diagnostics.cc b/mods/src/collective_diagnostics.cc
new file mode 100644
index 0000000..bcedfad
--- /dev/null
+++ b/mods/src/collective_diagnostics.cc
@@ -0,0 +1,180 @@
+#include "collective_diagnostics.h"
+#include "version.h"
+
+#include <nlohmann/json.hpp>
+#include <spdlog/sinks/base_sink.h>
+#include <spdlog/sinks/basic_file_sink.h>
+#include <spdlog/spdlog.h>
+
+#include <atomic>
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <string>
+
+#if _WIN32
+#include <Windows.h>
+#include <DbgHelp.h>
+#endif
+
+namespace CollectiveDiagnostics
+{
+namespace
+{
+constexpr const char* kBuild = "community-r18-single-account-v1";
+std::shared_ptr<spdlog::logger> logger;
+const auto started = std::chrono::steady_clock::now();
+struct Attempt {
+  const char* name = nullptr;
+  bool enabled = false;
+  unsigned warnings = 0;
+  unsigned errors = 0;
+};
+thread_local Attempt attempt;
+unsigned returned_clean = 0, returned_warn = 0, returned_error = 0, threw = 0, skipped = 0;
+
+void Write(nlohmann::json record) noexcept
+{
+  try {
+    if (!logger) return;
+    record["build"] = kBuild;
+    record["elapsed_ms"] = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - started).count();
+    record["time_unix_ms"] = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    logger->info("{}", record.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace));
+    logger->flush();
+  } catch (...) { /* Diagnostic I/O must not interrupt the game. */ }
+}
+
+class WarningsSink final : public spdlog::sinks::base_sink<std::mutex>
+{
+  void sink_it_(const spdlog::details::log_msg& message) override
+  {
+    if (message.level < spdlog::level::warn) return;
+    if (attempt.name && attempt.enabled) {
+      if (message.level >= spdlog::level::err) ++attempt.errors;
+      else ++attempt.warnings;
+    }
+    Write({{"event", "mod_warning_or_error"},
+           {"level", static_cast<int>(message.level)},
+           {"patch", attempt.name ? attempt.name : "runtime"},
+           {"message", std::string(message.payload.data(), message.payload.size())}});
+  }
+  void flush_() override {}
+};
+
+#if _WIN32
+wchar_t dump_path[32768] = {};
+LPTOP_LEVEL_EXCEPTION_FILTER previous_filter = nullptr;
+std::atomic_flag dumping = ATOMIC_FLAG_INIT;
+const char module_anchor = 0;
+
+LONG WINAPI WriteCrashDump(EXCEPTION_POINTERS* exception)
+{
+  // Prepare the filename at startup; no logger, JSON, or path allocation here.
+  if (!dumping.test_and_set() && dump_path[0]) {
+    const HANDLE file = CreateFileW(dump_path, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
+                                    FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file != INVALID_HANDLE_VALUE) {
+      MINIDUMP_EXCEPTION_INFORMATION info{GetCurrentThreadId(), exception, FALSE};
+      MiniDumpWriteDump(GetCurrentProcess(), GetCurrentProcessId(), file, MiniDumpNormal,
+                        exception ? &info : nullptr, nullptr, nullptr);
+      CloseHandle(file);
+    }
+  }
+  if (previous_filter && previous_filter != WriteCrashDump) return previous_filter(exception);
+  return EXCEPTION_CONTINUE_SEARCH;
+}
+
+void InitializeWindows(const std::filesystem::path& main_log)
+{
+  HMODULE module = nullptr;
+  wchar_t module_name[32768] = {};
+  GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                    reinterpret_cast<LPCWSTR>(&module_anchor), &module);
+  const DWORD length = module ? GetModuleFileNameW(module, module_name, 32768) : 0;
+  const auto stamp = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+  auto path = main_log;
+  path.replace_extension();
+  path += "_collective_crash_" + std::to_string(GetCurrentProcessId()) + "_" + std::to_string(stamp) + ".dmp";
+  const auto wide = path.wstring();
+  if (wide.size() < std::size(dump_path)) {
+    std::copy(wide.begin(), wide.end(), dump_path);
+    dump_path[wide.size()] = 0;
+    previous_filter = SetUnhandledExceptionFilter(WriteCrashDump);
+  }
+  Write({{"event", "windows_identity"}, {"process_id", GetCurrentProcessId()},
+         {"loaded_dll", length && length < 32768 ? std::filesystem::path(module_name).string() : "unavailable"},
+         {"crash_dump", wide.size() < std::size(dump_path) ? path.string() : "path_too_long"},
+         {"crash_dump_policy", "best_effort_on_unhandled_exception; handler_chains_previous"}});
+}
+#endif
+}
+
+void Initialize(const char* main_log, const char* config_path) noexcept
+{
+  try {
+    auto path = std::filesystem::path(main_log);
+    const auto main_path = path;
+    path.replace_extension();
+    path += "_collective_diagnostic.log";
+    logger = spdlog::basic_logger_mt("collective_diagnostic", path.string(), false);
+    logger->set_pattern("%v");
+    auto warnings = std::make_shared<WarningsSink>();
+    warnings->set_level(spdlog::level::warn);
+    spdlog::default_logger()->sinks().push_back(std::move(warnings));
+    Write({{"event", "startup"}, {"mod_version", VER_FILE_VERSION_STR},
+           {"source", "37e33084b711499c1ae3cc1988b58400c097546f"},
+           {"main_log", main_log}, {"config", config_path}, {"diagnostic_log", path.string()},
+           {"hook_status_policy", "installer_return_and_logged_errors; not_proof_of_functioning_hook"}});
+#if _WIN32
+    InitializeWindows(main_path);
+#endif
+  } catch (const std::exception& error) {
+    // Do not forward through the warning sink while initialising it.
+    try { spdlog::info("Collective diagnostic file unavailable: {}", error.what()); } catch (...) {}
+  } catch (...) {}
+}
+
+void BeginPatch(const char* name, bool enabled) noexcept
+{
+  attempt = {name, enabled, 0, 0};
+  try { Write({{"event", "patch_begin"}, {"patch", name}, {"enabled", enabled}}); } catch (...) {}
+}
+
+void EndPatch(const char* exception) noexcept
+{
+  if (!attempt.name) return;
+  const char* status = "returned_no_logged_issues";
+  if (!attempt.enabled) { status = "disabled"; ++skipped; }
+  else if (exception) { status = "exception"; ++threw; }
+  else if (attempt.errors) { status = "returned_with_errors"; ++returned_error; }
+  else if (attempt.warnings) { status = "returned_with_warnings"; ++returned_warn; }
+  else { ++returned_clean; }
+  try {
+    Write({{"event", "patch_end"}, {"patch", attempt.name}, {"status", status},
+           {"warnings", attempt.warnings}, {"errors", attempt.errors}, {"exception", exception ? exception : ""}});
+  } catch (...) {}
+  attempt = {};
+}
+
+void Summarize(unsigned expected) noexcept
+{
+  const unsigned finished = returned_clean + returned_warn + returned_error + threw + skipped;
+  try {
+    Write({{"event", "hook_summary"}, {"returned_no_logged_issues", returned_clean},
+           {"returned_with_warnings", returned_warn}, {"returned_with_errors", returned_error},
+           {"exceptions", threw}, {"disabled", skipped}, {"pending", expected > finished ? expected - finished : 0},
+           {"note", "A normal installer return does not prove its hooks installed or work in game."}});
+  } catch (...) {}
+}
+
+void Event(std::string_view name, std::string_view detail) noexcept
+{
+  try { Write({{"event", std::string(name)}, {"detail", std::string(detail)}}); } catch (...) {}
+}
+}
