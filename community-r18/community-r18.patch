+bool Blocked(int64_t target, uint64_t own)
+{
+  Load();
+  if (excluded.contains(target)) { Record("skip_permanent_exclusion", target, own); return true; }
+  if (cooldowns.Contains(own, target, Now())) { Record("skip_temporary_cooldown", target, own); return true; }
+  return false;
+}
+bool Skip(int64_t target, uint64_t own)
+{
+  if (Blocked(target, own)) return true;
+  const auto it = tracks.find(target);
+  const bool moving_now = it != tracks.end() && it->second.motion.RecentlyMoving(Now());
+  if (!moving_now) {
+    Record("skip_motion_not_confirmed", target, own);
+    return true;
+  }
+  return false;
+}
+Motion CurrentMotion(int64_t target)
+{
+  const auto it=tracks.find(target);
+  return it == tracks.end() ? Motion::Unknown : it->second.motion.Current(Now());
+}
+void Cooldown(int64_t target, uint64_t own, const char* reason, int64_t duration_ms)
+{
+  const auto effective_duration=cooldowns.Put(own, target, Now(), duration_ms);
+  Write({{"event", "target_temporary_cooldown"}, {"target_id", std::to_string(target)},
+         {"own_id", std::to_string(own)}, {"reason", reason}, {"duration_ms", effective_duration}, {"initial_duration_ms", duration_ms},
+         {"permanent", false}});
+}
+bool KnownDestroyed(FleetDeployedData* target)
+{
+  return Scalar(Object(target), "IsDestroyed") == true;
+}
+uint64_t Selected(int64_t target, FleetPlayerData* own, double distance2)
+{
+  CaptureIdentity(VisibleHostileModel(target));
+  const auto attempt = ++attempt_sequence;
+  auto& current = focus[own->Id];
+  if (current.target != target) { ClearEvidence(own->Id); current = {}; }
+  current.target = target;
+  current.attempt = attempt;
+  current.combat_seen = current.combat_seen || own->CurrentState == FleetState::Battling;
+  const auto it = tracks.find(target);
+  Write({{"event", "selected_nearest"}, {"target_id", std::to_string(target)},
+         {"own_id", std::to_string(own->Id)}, {"attempt", attempt}, {"distance2", distance2},
+         {"distance_source", "FleetDeployedData.SystemPosition"},{"selection_reason","elite_priority_then_intercept_or_nearest"},
+         {"motion", it == tracks.end() ? "unknown" : MotionName(it->second.motion.State())},
+         {"moving_now", it != tracks.end() && it->second.motion.RecentlyMoving(Now())}});
+  return attempt;
+}
+Attack ObserveButton(ScanEngageButtonsWidget* buttons, FleetDeployedData* target,
+                     FleetPlayerData* own, uint64_t attempt)
+{
+  if (!buttons || !target || !own) return Attack::Unknown;
+  const auto id = target->GetId64();
+  const auto now = Now();
+  const auto result = AttackButton(buttons);
+  const auto metadata = TargetMetadata(target);
+  Position a, b;
+  const bool has_positions = PositionOf(static_cast<int64_t>(own->Id), a) && PositionOf(id, b);
+  const auto distance2 = has_positions ? Distance2(a,b) : -1;
+  const auto it = tracks.find(id);
+  const auto motion = it == tracks.end() ? Motion::Unknown : it->second.motion.State();
+  const bool moving_now = it != tracks.end() && it->second.motion.RecentlyMoving(now);
+  auto current = focus.find(own->Id);
+  const bool tracked_attempt = attempt && current != focus.end()
+                               && current->second.target == id && current->second.attempt == attempt;
+  const bool combat = own->CurrentState == FleetState::Battling;
+  if (combat) {
+    if (tracked_attempt) current->second.combat_seen = true;
+    ClearEvidence(own->Id);
+  }
+  const bool combat_seen = combat || (tracked_attempt && current->second.combat_seen);
+  auto& failure = evidence[EvidenceKey(own->Id, id)];
+  const auto before = failure.Count();
+  const bool reject = tracked_attempt && has_positions && failure.Observe(attempt, now, distance2, result.state,
+      own->CurrentState == FleetState::IdleInSpace, TargetIdle(metadata),
+      moving_now ? Motion::Moving : motion, combat_seen);
+  const auto observation_key = EvidenceKey(own->Id, id);
+  auto& last_logged = last_observation[observation_key];
+  auto& last_attack = last_button_state[observation_key];
+  auto& last_attempt = last_observation_attempt[observation_key];
+  if (now - last_logged >= 2000 || failure.Count() != before || last_attack != result.state || last_attempt != attempt) {
+    Write({{"event", "target_observation"}, {"target_id", std::to_string(id)}, {"own_id", std::to_string(own->Id)},
+           {"attempt", attempt}, {"origin", tracked_attempt ? "F6" : "manual_or_other"},
+           {"attack", AttackName(result.state)}, {"attack_control", result.details},
+           {"metadata", metadata}, {"own_state", static_cast<int>(own->CurrentState)},
+           {"combat_observed", combat_seen}, {"distance2", has_positions ? Json(distance2) : Json(nullptr)},
+           {"position_source", "FleetDeployedData.SystemPosition"},
+           {"target_position", has_positions ? PositionJson(b) : Json(nullptr)},
+           {"own_position", has_positions ? PositionJson(a) : Json(nullptr)}, {"motion", MotionName(motion)},
+           {"moving_now", moving_now},
+           {"latest_step2", it == tracks.end() ? 0 : it->second.motion.LatestStep2()},
+           {"motion_window_ms", it == tracks.end() ? 0 : it->second.motion.Span()},
+           {"motion_displacement2", it == tracks.end() ? 0 : it->second.motion.Displacement2()},
+           {"failed_distinct_attempts", failure.Count()}});
+    last_logged = now;
+    last_attack = result.state;
+    last_attempt = attempt;
+  }
+  if (reject && excluded.insert(id).second) {
+    exclusion_entries.push_back({{"target_id", std::to_string(id)}, {"system_node_id", metadata["system_node_id"]},
+        {"reason", "stationary_disabled_attack_repeated_near_zero_no_combat"},
+        {"attempts", failure.Count()}, {"distance2", distance2}});
+    const auto saved = Save();
+    Write({{"event", "target_excluded"}, {"target_id", std::to_string(id)},
+           {"persisted", saved}, {"scope", saved ? "profile_permanent" : "session_only"}});
+  }
+  return result.state;
+}
+void Dispatched(int64_t target, FleetPlayerData* own, uint64_t attempt)
+{
+  focus[own->Id].progress.Begin(Now());
+  Write({{"event", "engage_handler_called"}, {"target_id", std::to_string(target)},
+         {"own_id", std::to_string(own->Id)}, {"attempt", attempt}, {"combat_confirmed", false}});
+}
