+Il2CppObject* Reference(Il2CppObject* object,const char* name) {
+ if(!object)return nullptr;
+ const auto* prop=il2cpp_class_get_property_from_name(il2cpp_object_get_class(object),name);
+ const auto* get=prop?il2cpp_property_get_get_method(const_cast<PropertyInfo*>(prop)):nullptr;
+ const auto* type=get?il2cpp_method_get_return_type(get):nullptr;
+ if(!get || get->parameters_count || (get->flags&METHOD_ATTRIBUTE_STATIC) || !type || type->byref
+    || (type->type!=IL2CPP_TYPE_CLASS && type->type!=IL2CPP_TYPE_OBJECT && type->type!=IL2CPP_TYPE_GENERICINST && type->type!=IL2CPP_TYPE_STRING))return nullptr;
+ Il2CppException* exception=nullptr;
+ auto* value=il2cpp_runtime_invoke(get,object,nullptr,&exception);
+ return exception?nullptr:value;
+}
+std::optional<bool> Boolean(Il2CppObject* object,const char* name) {
+ if(!object)return std::nullopt;
+ const auto* prop=il2cpp_class_get_property_from_name(il2cpp_object_get_class(object),name);
+ const auto* get=prop?il2cpp_property_get_get_method(const_cast<PropertyInfo*>(prop)):nullptr;
+ const auto* type=get?il2cpp_method_get_return_type(get):nullptr;
+ if(!get || get->parameters_count || (get->flags&METHOD_ATTRIBUTE_STATIC) || !type || type->byref || type->type!=IL2CPP_TYPE_BOOLEAN)return std::nullopt;
+ Il2CppException* exception=nullptr;
+ auto* value=il2cpp_runtime_invoke(get,object,nullptr,&exception);
+ if(exception || !value)return std::nullopt;
+ return *static_cast<bool*>(il2cpp_object_unbox(value));
+}
+#include "community_panel_ui.inc"
+bool ModalCanvas() {
