+    if (it->first.rfind(prefix, 0) == 0) it = evidence.erase(it); else ++it;
+}
+bool Save()
+{
+  if (!file_valid) return false;
+  const auto path = Sibling("_hostile_exclusions.json");
+  auto temporary = path;
+  temporary += ".tmp";
+  try {
+    const Json document = {{"schema", 1}, {"profile", std::filesystem::path(File::Log()).stem().string()},
+                           {"targets", exclusion_entries}};
+    {
+      std::ofstream output(temporary, std::ios::binary | std::ios::trunc);
+      output.exceptions(std::ios::badbit | std::ios::failbit);
+      output << document.dump(2) << '\n';
+      output.flush();
+    }
+#if _WIN32
+    if (!MoveFileExW(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+      throw std::runtime_error("MoveFileExW failed: " + std::to_string(GetLastError()));
+#else
+    std::filesystem::rename(temporary, path);
+#endif
+    return true;
+  } catch (const std::exception& error) {
+    Write({{"event", "exclusion_save_failed"}, {"error", error.what()}});
+    return false;
+  }
+}
+void Load()
+{
+  if (loaded) return;
+  loaded = true;
+  const auto path = Sibling("_hostile_exclusions.json");
+  const auto profile = std::filesystem::path(File::Log()).stem().string();
+  try {
+    if (std::filesystem::exists(path)) {
+      std::ifstream input(path);
+      auto document = Json::parse(input);
+      if (document.at("schema") != 1 || document.at("profile") != profile || !document.at("targets").is_array())
+        throw std::runtime_error("unrecognized exclusion schema or profile");
+      auto entries = document.at("targets");
+      std::unordered_set<int64_t> ids;
+      for (const auto& entry : entries) {
+        const auto text = entry.at("target_id").get<std::string>();
+        size_t consumed = 0;
+        const auto id = std::stoll(text, &consumed);
+        if (id <= 0 || consumed != text.size()) throw std::runtime_error("invalid target ID");
+        ids.insert(id);
+      }
+      excluded = std::move(ids);
+      exclusion_entries = std::move(entries);
+    }
+  } catch (const std::exception& error) {
+    file_valid = false;
+    Write({{"event", "exclusion_load_failed"}, {"error", error.what()}, {"existing_file_preserved", true}});
+  }
+  Write({{"event", "exclusions_loaded"}, {"profile", profile}, {"count", excluded.size()},
+         {"hardcoded_ids_added", false}, {"file_valid", file_valid}});
+}
+bool PositionOf(int64_t id, Position& position)
+{
+  float x = 0, y = 0, z = 0;
+  if (!TryVisibleFleetSystemPosition(id, x, y, z) || !std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z)) return false;
+  position = {x,y,z};
+  return true;
+}
+Json PositionJson(Position position) { return Json::array({position.x, position.y, position.z}); }
+FleetPlayerData* OwnFleet()
+{
+  auto* bar = ObjectFinder<FleetBarViewController>::Get();
+  auto* controller = bar ? bar->_fleetPanelController : nullptr;
+  return controller ? controller->fleet : nullptr;
+}
+void Poll()
+{
+  PursuitPoll();
+  static int64_t last = 0;
+  const auto now = Now();
+  if (now - last < 250) return;
+  if (last && now - last > 1500) {
+    evidence.clear();
+    for (auto& [id, current] : focus) current.progress.Reset();
+    Record("observation_gap_failure_evidence_reset");
+  }
+  last = now;
+  try {
+    auto* sections = Hub::get_SectionManager();
+    if (!sections || sections->CurrentSection != SectionID::Navigation_System) {
+      if (!tracks.empty() || !focus.empty()) Write({{"event", "view_lost_observations_reset"}});
+      tracks.clear(); identities.clear(); focus.clear(); evidence.clear(); last_observation.clear();
+      last_button_state.clear(); last_observation_attempt.clear();
+      sampled_own_id = 0;
+      return;
+    }
+    Load();
+    auto ids = VisibleRegularHostileIds();
+    std::unordered_set<int64_t> visible(ids.begin(), ids.end());
+    for (auto it = tracks.begin(); it != tracks.end(); ) {
+      if (!visible.contains(it->first)) {
+        Write({{"event", "target_left_visible_list"}, {"target_id", std::to_string(it->first)},
+               {"outcome", "unknown_disappearance_is_not_a_confirmed_kill"}});
+        for (auto& [own_id, current] : focus) if (current.target == it->first) {
+          Write({{"event", "focused_target_disappeared"}, {"target_id", std::to_string(it->first)},
+                 {"own_id", std::to_string(own_id)}, {"combat_observed", current.combat_seen}});
+          ClearEvidence(own_id); current = {};
+        }
+        identities.erase(it->first);
+        it = tracks.erase(it);
+      } else ++it;
+    }
+    for (const auto id : ids) {
+      Position position;
+      auto& tracked = tracks[id];
+      CaptureIdentity(VisibleHostileModel(id));
+      if (!PositionOf(id, position)) {
+        tracked.motion.Clear();
+        if (!tracked.missing_position_logged) Record("model_position_unavailable", id);
+        tracked.missing_position_logged=true;
+        continue;
+      }
+      if (tracked.missing_position_logged) Record("model_position_recovered", id);
+      tracked.missing_position_logged=false;
+      const auto motion = tracked.motion.Add(now, position);
+      tracked.last_seen = now;
+      const auto eligible = tracked.motion.RecentlyMoving(now);
+      if (motion != tracked.last_motion || eligible != tracked.last_eligible) {
+        Write({{"event", "target_motion_changed"}, {"target_id", std::to_string(id)},
+               {"motion", MotionName(motion)}, {"moving_now", eligible},
+               {"latest_step2", tracked.motion.LatestStep2()}, {"position", PositionJson(position)},
+               {"window_ms", tracked.motion.Span()}, {"maximum_displacement2", tracked.motion.Displacement2()},
+               {"source", "FleetDeployedData.SystemPosition"}});
+        tracked.last_motion = motion;
+        tracked.last_eligible = eligible;
+      }
+    }
+    auto* own = OwnFleet();
+    const auto own_id = own ? own->Id : 0;
+    if (own_id != sampled_own_id) {
+      evidence.clear();
+      for (auto& [id, current] : focus) current.progress.Reset();
+      Record("selected_ship_changed_failure_evidence_reset", 0, own_id);
+      sampled_own_id = own_id;
+    }
+    if (!own || !own_id) return;
+    TacticalSample(own);
+    std::string pause;
+    if (TacticalBusy(own,pause)) {
+      ClearEvidence(own_id);
+      if (auto it=focus.find(own_id);it!=focus.end()) {
+        it->second.progress.Reset();
+        if (pause=="combat_in_progress") {
+          it->second.combat_seen=true;
+          cooldowns.Erase(own_id,it->second.target);
+        }
+      }
+      return; // Queue/combat waiting cannot become target-failure evidence.
+    }
+    const auto state = own->CurrentState;
+    auto found = focus.find(own->Id);
+    if (found != focus.end()) {
+      auto& current = found->second;
+      if (state == FleetState::Battling) {
+        current.combat_seen = true;
+        ClearEvidence(own->Id);
+        cooldowns.Erase(own->Id, current.target);
+      }
+      if (current.progress.Failed(now, state == FleetState::IdleInSpace, state == FleetState::Battling))
+        Cooldown(current.target, own->Id, "engagement_not_observed_while_idle", 30000);
+      if (state != current.last_state) {
+        Write({{"event", "own_fleet_state"}, {"own_id", std::to_string(own->Id)},
+               {"target_id", std::to_string(current.target)}, {"state", static_cast<int>(state)},
+               {"combat_observed", current.combat_seen}});
+        current.last_state = state;
+      }
+    }
+    for (auto* viewer : ObjectFinder<PreScanTargetWidget>::GetAll()) {
+      auto* visibility = viewer ? viewer->_visibilityController : nullptr;
+      if (!visibility || (visibility->_state != VisibilityState::Visible && visibility->_state != VisibilityState::Show))
+        continue;
+      auto* buttons = viewer->_scanEngageButtonsWidget;
+      auto* battle = buttons ? buttons->Context : nullptr;
+      auto* target = battle ? battle->TargetFleetDeployedData : nullptr;
+      DeployedFleetType type{};
+      if (!target || !target->TryGetFleetType(type) || type != DeployedFleetType::Marauder) continue;
+      const auto attempt = found != focus.end() && found->second.target == target->GetId64()
+                               ? found->second.attempt : 0;
+      ObserveButton(buttons, target, own, attempt);
+    }
+  } catch (const std::exception& error) {
+    Write({{"event", "observation_error"}, {"error", error.what()}});
+  }
+}
