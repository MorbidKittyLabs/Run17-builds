+         {"callback_registered", registered}, {"motion_window_ms", MotionWindow::WindowMs},
+         {"movement_threshold2", MotionWindow::Movement2}, {"near_zero_threshold2", 0.001},
+         {"moving_only", true}, {"unknown_motion_eligible", false},
+         {"pursuit_policy", "retain_after_dispatch_until_invalid_or_strictly_nearer"},
+         {"ranking_source", "FleetDeployedData.SystemPosition"},
+         {"stationary_confirmation_ms", MotionWindow::StationaryProofMinSpanMs},
+         {"motion_step_threshold2", MotionWindow::MotionStep2},
+         {"motion_min_observation_ms", MotionWindow::MotionProofMinSpanMs},
+         {"motion_proof_max_age_ms", MotionWindow::MotionProofMaxAgeMs},
+         {"position_source", "FleetDeployedData.SystemPosition"},
+         {"unknown_button_behavior", "bounded_wait_then_temporary_cooldown"},
