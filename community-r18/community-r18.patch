+  path.replace_extension();path+="_fleet_diagnostics.log";
+  auto sink=std::make_shared<spdlog::sinks::rotating_file_sink_mt>(path.string(),4*1024*1024,3);
+  diagnostic_log_pool=std::make_shared<spdlog::details::thread_pool>(64,1);
+  diagnostic_logger=std::make_shared<spdlog::async_logger>("community_fleet_diagnostics",sink,diagnostic_log_pool,spdlog::async_overflow_policy::overrun_oldest);
+  diagnostic_logger->set_pattern("%v");diagnostic_logger->flush_on(spdlog::level::info);
+  StartStationDiagnostics();
+  DiagnosticEvent("monitor_started",GetTickCount64(),{{"max_slots",diagnostics::MaxDockSlots},
+    {"ui_poll_ms",200},{"roster_poll_ms",1000},{"detail_step_ms",250},{"snapshot_ms",2000},
+    {"retention_max_bytes",16*1024*1024},{"log_queue_records",64},{"log_record_max_bytes",96*1024},{"coverage","known_readers_only_not_every_internal_game_event"}});
+}
+void DiagnosticMonitor(uint64_t now,FleetBarViewController* bar,FleetPlayerData* own,SectionManager* sections,bool focused) noexcept {
+  try {
+    if(!diagnostic_logger)return;
+    if(diagnostic_schedule.UI(now)) {
+      PollStationDiagnostics(now);
+      auto ui=DiagnosticScreen(sections,focused);auto key=ui.dump();
+      if(key!=diagnostic_ui_key){diagnostic_ui_key=std::move(key);DiagnosticEvent("ui_context_changed",now,{{"previous",diagnostic_ui},{"current",ui}});}
+      diagnostic_ui=std::move(ui);
+    }
+    if(diagnostic_schedule.Roster(now)) {
+      const auto live=DiagnosticRoster(bar,own,diagnostic_roster_status);
+      if(!live.empty()) {
+        diagnostic_roster=Json::array();
+        for(auto* fleet:live)diagnostic_roster.push_back({{"id",std::to_string(fleet->Id)},
+          {"dock_index",fleet->Index},{"dock_number",fleet->Index>=0?Json(fleet->Index+1):Json(nullptr)},
+          {"state",static_cast<int>(fleet->CurrentState)},{"roster_sample_tick_ms",now}});
+        std::erase_if(detailed_docks,[&](const auto& sample){return std::ranges::none_of(live,[&](auto* fleet){return fleet->Id==sample.first;});});
+      }
+    }
+    if(const auto index=diagnostic_schedule.Detail(now,diagnostic_roster.size(),diagnostic_owner)) {
+      const auto& entry=diagnostic_roster[*index];const auto id=entry["id"].get<std::string>();
+      auto* manager=DiagnosticManager();bool failed=false;
+      auto* fleet=DiagnosticFleetAt(manager,entry["dock_index"].get<int>(),failed);
+      if(!fleet || std::to_string(fleet->Id)!=id) {
+        Json status;for(auto* candidate:DiagnosticRoster(bar,own,status))if(std::to_string(candidate->Id)==id){fleet=candidate;break;}
+      }
+      if(fleet && std::to_string(fleet->Id)==id) {
+        const auto started=GetTickCount64();
+        detailed_docks[fleet->Id]={started,fleet->Index,ShipHealth(fleet),FleetObservations(fleet)};
+        const auto duration=GetTickCount64()-started;
+        const auto& sample=detailed_docks.at(fleet->Id);
+        DiagnosticEvent("dock_detail_sample",started,{{"fleet_id",id},{"dock_index",fleet->Index},
+          {"state",static_cast<int>(fleet->CurrentState)},{"selected",fleet->Id==observed_selected_fleet},
+          {"read_duration_ms",duration},{"health",sample.health},{"observations",sample.observations},{"ui",diagnostic_ui}});
+        if(duration>10){diagnostic_schedule.next_detail=GetTickCount64()+750;DiagnosticEvent("slow_detail_read",now,{{"fleet_id",id},{"duration_ms",duration}});}
+      } else diagnostic_schedule.next_roster=0;
+    }
+    if(diagnostic_schedule.Log(now)) {
+      Json fleets=diagnostic_roster;
+      for(auto& fleet:fleets) {
+        const auto id=std::stoull(fleet["id"].get<std::string>());
+        const auto sample=detailed_docks.find(id);
+        fleet["selected"]=id==observed_selected_fleet;
+        fleet["roster_age_ms"]=now>=fleet["roster_sample_tick_ms"].get<uint64_t>()?Json(now-fleet["roster_sample_tick_ms"].get<uint64_t>()):Json(nullptr);
+        const bool detailed=diagnostic_owner && sample!=detailed_docks.end() && sample->second.dock==fleet["dock_index"].get<int>();
+        fleet["details_available"]=detailed;
+        fleet["health_values_available"]=detailed && sample->second.health["hull"].value("available",false) && sample->second.health["shield"].value("available",false);
+        fleet["detail_age_ms"]=detailed&&now>=sample->second.tick?Json(now-sample->second.tick):Json(nullptr);
+        if(detailed) {
+          fleet["health_summary"]={{"hull_percent",sample->second.health["hull"].value("percent",Json(nullptr))},
+            {"shield_percent",sample->second.health["shield"].value("percent",Json(nullptr))}};
+          fleet["detail_event"]="dock_detail_sample";
+        }
+      }
+      DiagnosticEvent("fleet_snapshot",now,{{"enumeration",diagnostic_roster_status},{"fleets",std::move(fleets)},
+        {"ui",diagnostic_ui},{"server_freshness","client_model_server_age_unverified"}});
+    }
+  } catch(const std::exception& error) {
+    diagnostic_schedule.Failure(now);
+    try{DiagnosticEvent("diagnostic_error",now,{{"message",std::string(error.what()).substr(0,200)}});}catch(...){}
+  } catch(...) {diagnostic_schedule.Failure(now);}
+}
+
+} // namespace
+void Pump() noexcept {
+  try {
+    static bool started=false;
+    if(!started) {
+      started=true;
+      FILETIME a{},b{},c{},d{};
+      if(GetProcessTimes(GetCurrentProcess(),&a,&b,&c,&d))
+        creation=(static_cast<uint64_t>(a.dwHighDateTime)<<32)|a.dwLowDateTime;
+      StartDiagnosticMonitor();
+    }
+    auto* bar=ObjectFinder<FleetBarViewController>::Get();
+    auto* controller=bar?bar->_fleetPanelController:nullptr;
+    auto* own=controller?controller->fleet:nullptr;
+    observed_selected_fleet=own?own->Id:0;
+    DWORD foreground=0;GetWindowThreadProcessId(GetForegroundWindow(),&foreground);
+    DiagnosticMonitor(GetTickCount64(),bar,own,Hub::get_SectionManager(),foreground==GetCurrentProcessId());
+  } catch(...) { /* A diagnostic failure must never interrupt the client. */ }
+}
+// One explicit F7 press issues at most one native recall per eligible fleet.
+// No selection changes, timers, retries, repair actions, or other clients.
+void RecallAll() noexcept {
+  try {
+    auto* bar=ObjectFinder<FleetBarViewController>::Get();
+    auto* controller=bar?bar->_fleetPanelController:nullptr;
+    if(!controller)return;
+    Json status;
+    const auto roster=DiagnosticRoster(bar,nullptr,status);
+    int requested=0;
+    for(auto* fleet:roster) {
+      const auto state=fleet->CurrentState;
+      if(state!=FleetState::IdleInSpace && state!=FleetState::Impulsing
+          && state!=FleetState::Mining && state!=FleetState::Capturing)continue;
+      uint64_t id=fleet->Id;
+      // Same typed, native request path used by the existing Recall shortcut.
+      // Pass the intended own fleet explicitly; never mutate UI selection.
+      const bool accepted=controller->RequestAction(fleet,ActionType::Recall,0,ActionBehaviour::Default);
+      if(accepted)++requested;
+      DiagnosticEvent("manual_recall_requested",GetTickCount64(),{{"fleet_id",std::to_string(id)},{"accepted",accepted}});
+    }
+    spdlog::info("F7: native recall requested for {} eligible fleets",requested);
+  } catch(...) {spdlog::warn("F7 recall unavailable in the current client context");}
+}
+} // namespace fleet_diagnostics
+#else
+namespace fleet_diagnostics { void Pump() noexcept {} void RecallAll() noexcept {} }
+#endif
